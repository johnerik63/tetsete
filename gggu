  // Todos os valores que aparecem naquela coluna, com quantas linhas usam cada um.
  function valoresDaColuna(nome){
    var conta = {};
    planilha.linhas.forEach(function (l) {
      if (!l) return;
      var v = l[nome];
      if (v == null || String(v).trim() === "") return;
      v = String(v);
      conta[v] = (conta[v] || 0) + 1;
    });
    return conta;
  }

  function editarOpcoes(i){
    var e = estrutura[i];
    var conta = valoresDaColuna(e.nomeOrig);
    var todos = Object.keys(conta).sort(function (a, b) { return a.localeCompare(b, "pt-BR"); });
    e.opcoes.forEach(function (o) { if (todos.indexOf(o) < 0) todos.push(o); });

    var marcada = {};
    if (e.opcoes.length) e.opcoes.forEach(function (o) { marcada[o] = true; });
    else todos.forEach(function (o) { marcada[o] = true; });   // nada escolhido = todas valem

    function pintar(busca){
      var q = String(busca || "").toLowerCase()
        .normalize("NFD").replace(/[\u0300-\u036f]/g, "");
      var lista = todos.filter(function (o) {
        if (!q) return true;
        return o.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").indexOf(q) >= 0;
      });
      $("opcLista").innerHTML = lista.length
        ? lista.map(function (o) {
            return '<label><input type="checkbox" data-o="' + esc(o) + '"'
              + (marcada[o] ? " checked" : "") + "> <span>" + esc(o) + "</span>"
              + "<small>" + (conta[o] ? conta[o] + " linha(s)" : "só na lista") + "</small></label>";
          }).join("")
        : '<div class="nada">Nada com esse texto.</div>';
      var n = todos.filter(function (o) { return marcada[o]; }).length;
      $("opcPe").textContent = n + " de " + todos.length + " valor(es) vão aparecer"
        + (n === todos.length ? " — e valores novos que chegarem entram sozinhos." : ".");
    }

    planilha.janela({
      titulo: "Opções de " + e.nome,
      sub: "Marque o que pode aparecer na lista suspensa e nas células de preencher.",
      miolo: '<div class="opcTopo">'
           +   '<input type="text" id="opcBusca" placeholder="Buscar valor…">'
           +   '<button type="button" id="opcTodas">Marcar todas</button>'
           +   '<button type="button" id="opcNenhuma">Nenhuma</button>'
           + "</div>"
           + '<div class="opcLista" id="opcLista"></div>'
           + '<div class="opcTopo" style="margin:10px 0 0">'
           +   '<input type="text" id="opcNova" placeholder="Acrescentar um valor que ainda não existe…">'
           +   '<button type="button" id="opcAdd">Acrescentar</button>'
           + "</div>"
           + '<div class="opcPe" id="opcPe"></div>',
      botoes: [
        { rotulo:"Cancelar", fecha:true },
        { rotulo:"Guardar", classe:"pri", acao:function () {
            var escolhidas = todos.filter(function (o) { return marcada[o]; });
            // todas marcadas = deixo vazio, aí ele se atualiza sozinho quando chegar valor novo
            e.opcoes = escolhidas.length === todos.length ? [] : escolhidas;
            planilha.fecharJanela();
            pintarAdm();
          } }
