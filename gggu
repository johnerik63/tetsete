  }

  function textoDaCelula(c, v){
    if (v == null || String(v) === "") return "";
    var f = formatoDe(c), t;
    if (f === "raw")   return String(v);
    else if (f === "moeda") t = moeda(num(v));
    else if (f === "cnpj")  t = cnpjMask(v);
    else if (f === "int")   t = inteiro(num(v));
    else if (f === "data")  t = dataBr(v);
    else return String(v);
    // formato escolhido não combina com o conteúdo: mostra o valor como está,
    // em vez de deixar a célula em branco
    return t === "" ? String(v) : t;
  }
  function medirColunas(){
    medidoCom = planilha.linhas.length;
    var cv = document.createElement("canvas"), ctx = cv.getContext && cv.getContext("2d");
    if (!ctx) return;
    var fCab = '600 11px Inter,"Segoe UI",system-ui,sans-serif';
    var fCel = '12px Inter,"Segoe UI",system-ui,sans-serif';
    var n = Math.min(planilha.linhas.length, AMOSTRA);
    cols.forEach(function(c){
      var k = cfg(c);
      ctx.font = fCab;
      var w = ctx.measureText(String(c.nome)).width + 30;
      ctx.font = fCel;
      var extra = 18 + (chipDe(c) ? 14 : 0) + (c.editavel ? 6 : 0);
      for (var i = 0; i < n; i++) {
        if (!planilha.linhas[i]) continue;
        var t = textoDaCelula(c, planilha.linhas[i][c.nome]);
        if (!t) continue;
        var lw = ctx.measureText(t).width + extra;
        if (lw > w) w = lw;
      }
      medidas[String(c.nome).toLowerCase()] = Math.max(MIN_COL, Math.min(MAX_COL, Math.ceil(w)));
    });
  }
  function larguraDe(c){
    var n = String(c.nome).toLowerCase();
    if (larguras[n]) return larguras[n];
    if (medidas[n]) return medidas[n];
    var k = cfg(c);
    if (k.w) return k.w;
    return c.tipo === "numero" ? 120 : (c.tipo === "data" ? 130 : 160);
  }
  function largurasFinais(fixo){
    var ws = vis.map(larguraDe);
    if (!ws.length) return ws;
    var disp = ($("env").clientWidth || 0) - 2;
    if (disp < 200) return ws;
    var i, idx = fixo ? fixo.i : -1;
    if (idx >= 0 && idx < ws.length) ws[idx] = Math.max(MIN_COL, fixo.w);
    var total = 0; for (i=0;i<ws.length;i++) total += ws[i];
    if (total >= disp) return ws;
    var sobra = disp - (idx >= 0 ? ws[idx] : 0), outras = 0;
    for (i=0;i<ws.length;i++) if (i!==idx) outras += ws[i];
    if (!outras) return ws;
    var f = sobra / outras;
    for (i=0;i<ws.length;i++) if (i!==idx) ws[i] = Math.max(MIN_COL, Math.floor(ws[i]*f));
    var soma = 0, maior = -1;
    for (i=0;i<ws.length;i++){ soma += ws[i]; if (i!==idx && (maior<0 || ws[i]>ws[maior])) maior = i; }
    var dif = disp - soma;
    if (maior >= 0 && dif > 0) ws[maior] += dif;
    return ws;
  }
  function aplicarLarguras(ws){
    var cg = $("cg").children;
    for (var i=0;i<cg.length && i<ws.length;i++) cg[i].style.width = ws[i] + "px";
  }

  function montarCabecalho(){
    var cg = "", th1 = "", esq = 0, ws = largurasFinais(), somaW = 0;
    for (var q=0;q<ws.length;q++) somaW += ws[q];
    var dispW = ($("env").clientWidth || 0) - 2;
    $("tab").style.width = somaW < dispW ? "100%" : "";
    $("tab").classList.add("apertado");
    vis.forEach(function(c, j){
      var fixa = congelar && j < 2, w = ws[j];
      cg += '<col style="width:' + w + 'px">';
      var estilo = fixa ? ' style="left:' + esq + 'px"' : "";
      var cls = (fixa ? "fixa" : "") + (fixa && j === 1 ? " borda-fixa" : "");
      th1 += '<th class="' + cls + '"' + estilo + ' data-ord="' + esc(c.nome) + '" title="' + esc(c.nome)
           + ' — clique para ordenar (crescente / decrescente / original).">'
           + esc(c.nome) + '<span class="seta" data-seta="' + esc(c.nome) + '">' + esc(textoSeta(c.nome)) + '</span>'
           + '<span class="puxa" data-puxa="' + j + '"></span></th>';
      if (fixa) esq += w;
    });
    $("cg").innerHTML = cg;
    $("cab").innerHTML = "<tr>" + th1 + "</tr>";
    $("cab").querySelectorAll("[data-ord]").forEach(function(th){
      th.addEventListener("click", function(ev){
        if (ev.target.hasAttribute("data-puxa")) return;
        var n = th.getAttribute("data-ord");
        // ordenar mexe na carteira toda, então ela precisa estar toda aqui
        planilha.garantirTudo().then(function () {
          return planilha.tela.pesado("Ordenando por " + n, totalTxt(), function () {
            if (posOrdem(n) < 0) ordens = [{col:n, dir:1}];
            else if (ordens[0].dir > 0) ordens = [{col:n, dir:-1}];
            else ordens = [];
            atualizarSetas(); carregarDados(); desenhar();
          });
        });
      });
    });
    montarFiltros();
    ligarPuxadores();
  }

  function montarFiltros(){
    var itens = vis.filter(function(c){ return !!c.filtro; });
    if (!itens.length) {
      $("filtros").innerHTML = ""; $("filtros").classList.remove("on");
      $("btFiltros").style.display = "none"; return;
    }
    $("btFiltros").style.display = "";
    $("filtros").innerHTML = itens.map(function(c){
      return '<div class="campoF"><div class="rot" title="' + esc(c.nome) + '">'
        + esc(c.nome) + "</div>" + filtroHtml(c) + "</div>";
    }).join("");
    $("filtros").classList.toggle("on", filtrosAbertos);
    $("btFiltros").classList.toggle("lig", filtrosAbertos);
    ligarFiltros();
  }
  var TIPOS_FILTRO = {
    texto:  [["contem","Contém"],["igual","Igual a"],["comeca","Começa com"]],
    numero: [["intervalo","De / até"],["igual","Igual a"],["minimo","A partir de"],["maximo","Até"]],
    data:   [["intervalo","De / até"],["igual","Data exata"],["de","A partir de"],["ate","Até"]],
    opcao:  [["lista","Lista suspensa"]]
  };
  function padraoFiltro(tipo){ return (TIPOS_FILTRO[tipo] || TIPOS_FILTRO.texto)[0][0]; }

  // O que o filtro oferece sai dos DADOS da carteira inteira — não da amostra de
  // 300 linhas que ficou guardada na coluna quando ela foi importada. Antes, o
  // filtro de cliente mostrava 31 nomes (29 nem existiam mais) para 150 mil linhas.
  //   vals    -> valores distintos, ou null se passar de MAX_OPCOES_FILTRO
  //   numeros -> todo valor é número "limpo" (31-60 e 180+ não são)
  var MAX_OPCOES_FILTRO = 300, cacheOpcoes = {};
  function soNumero(v){ return /^-?[\d.,]+$/.test(String(v).replace(/\s|R\$|%/g, "")); }
  function valoresDoFiltro(c){
    var n = String(c.nome);
    if (cacheOpcoes[n]) return cacheOpcoes[n];
    var vistos = Object.create(null), qtd = 0, numeros = true, L = planilha.linhas || [];
    for (var i = 0; i < L.length; i++) {
      var l = L[i]; if (!l) continue;
      var v = l[n];
      if (v == null || v === "") continue;
      v = String(v);
      if (vistos[v]) continue;
      vistos[v] = 1;
      if (numeros && !soNumero(v)) numeros = false;
      if (++qtd > MAX_OPCOES_FILTRO) break;
    }
    var info = {
      vals: qtd > MAX_OPCOES_FILTRO ? null
          : Object.keys(vistos).sort(function (a, b) {
              return a.localeCompare(b, "pt-BR", { numeric:true }); }),
      numeros: numeros
    };
    // com a carteira ainda chegando a lista pode crescer: só guarda quando estiver completa
    if (planilha.estaCompleto()) cacheOpcoes[n] = info;
    return info;
  }
  function selectFiltro(at, vals, sel){
    if (sel && vals.indexOf(sel) < 0) vals = vals.concat([sel]);
    return '<select' + at + ' data-p="eq"' + (sel ? ' class="ativo"' : "") + '>'
      + '<option value="">(todas)</option>'
      + vals.map(function(o){
          return "<option" + (o === sel ? " selected" : "") + ">" + esc(o) + "</option>"; }).join("")
      + "</select>";
  }

  function filtroHtml(c){
    var f = planilha.filtros[c.nome];
    if (!f || typeof f !== "object") f = {};
    var at = ' data-f="' + esc(c.nome) + '"';
    var ft = c.filtroTipo || padraoFiltro(c.tipo);
    function campo(tipo, chave, dica){
      return '<input type="' + tipo + '"' + at + ' data-p="' + chave + '" placeholder="' + esc(dica)
        + '" title="' + esc(dica) + '" value="' + esc(f[chave] || "") + '"'
        + (f[chave] ? ' class="ativo"' : "") + ">";
    }
    if (c.tipo === "opcao") {
      var infoO = valoresDoFiltro(c);
      // valor demais para caber numa lista suspensa (cliente, contrato…): vira "contém"
      if (!infoO.vals) return campo("text", "txt", "contém");
      return selectFiltro(at, infoO.vals, f.eq || "");
    }
    if (c.tipo === "numero") {
      // "31-60", "180+": parece número mas é faixa — "de 45 até 60" não achava a 31-60.
      // Poucos valores e nem todos números limpos: lista suspensa com as faixas.
      var infoN = valoresDoFiltro(c);
      if (infoN.vals && !infoN.numeros) return selectFiltro(at, infoN.vals, f.eq || "");
      if (ft === "igual")  return campo("number", "eq",  "igual a");
      if (ft === "minimo") return campo("number", "min", "a partir de");
      if (ft === "maximo") return campo("number", "max", "até");
      return '<div class="par">' + campo("number","min","de") + campo("number","max","até") + "</div>";
    }
    if (c.tipo === "data") {
      if (ft === "igual") return campo("date", "eq",  "data exata");
      if (ft === "de")    return campo("date", "de",  "a partir de");
      if (ft === "ate")   return campo("date", "ate", "até");
      return '<div class="par">' + campo("date","de","de") + campo("date","ate","até") + "</div>";
    }
    return campo("text", "txt", ft === "igual" ? "igual a" : (ft === "comeca" ? "começa com" : "contém"));
  }

  function ligarFiltros(){
    $("filtros").querySelectorAll("[data-f]").forEach(function(el){
      var nome = el.getAttribute("data-f"), c = acharCol(nome);
      if (!c) return;
      var ev = (el.tagName === "SELECT" || el.type === "date") ? "change" : "input";
      el.addEventListener(ev, function(){
        el.classList.toggle("ativo", !!el.value);
        // um relógio por campo: com um só, mexer em dois filtros em menos de
        // 220 ms (ou digitar na busca logo depois) jogava fora o primeiro — o campo
        // ficava laranja, mas o filtro não entrava
        var caixaF = el.closest(".campoF");
        clearTimeout(caixaF.__t);
        caixaF.__t = setTimeout(function(){
          planilha.garantirTudo().then(function () {
            return planilha.tela.pesado("Filtrando a carteira", totalTxt(), aplicar);
          });
        }, 220);
        function aplicar(){
          var caixa = el.closest(".campoF"), val = {};
          caixa.querySelectorAll("[data-p]").forEach(function(x){
            if (x.value !== "") val[x.getAttribute("data-p")] = x.value;
          });
          var semNada = !Object.keys(val).length;
          if (!semNada) {
            if (c.tipo === "numero" && el.tagName !== "SELECT") val.num = true;
            if (c.tipo === "texto")  val.modo = c.filtroTipo || "contem";
          }
          aplicando = true;
          try { planilha.filtro(nome, semNada ? "" : val); } catch (e) { console.warn(e); }
          aplicando = false;
          carregarDados(); desenhar();
        }
      });
    });
  }

  function ligarPuxadores(){
    $("cab").querySelectorAll("[data-puxa]").forEach(function(p){
      p.addEventListener("mousedown", function(ev){
        ev.preventDefault(); ev.stopPropagation();
        var j = +p.getAttribute("data-puxa"), x0 = ev.clientX;
        var w0 = $("cg").children[j] ? parseFloat($("cg").children[j].style.width) : larguraDe(vis[j]);
        var ultimas = null;
        function move(e){
          ultimas = largurasFinais({ i:j, w: Math.max(MIN_COL, w0 + (e.clientX - x0)) });
          aplicarLarguras(ultimas);
        }
        function solta(){
          document.removeEventListener("mousemove", move);
          document.removeEventListener("mouseup", solta);
          if (ultimas) vis.forEach(function(c,i){ larguras[String(c.nome).toLowerCase()] = ultimas[i]; });
          gravarPref(); montarCabecalho();
        }
        document.addEventListener("mousemove", move);
        document.addEventListener("mouseup", solta);
      });
      p.addEventListener("dblclick", function(ev){
        ev.preventDefault(); ev.stopPropagation();
        var c = vis[+p.getAttribute("data-puxa")];
        delete larguras[String(c.nome).toLowerCase()];
        gravarPref(); montarCabecalho();
      });
    });
  }
  function acharCol(nome){
    var q = String(nome).toLowerCase();
    for (var i=0;i<cols.length;i++) if (String(cols[i].nome).toLowerCase() === q) return cols[i];
    return null;
  }

  function chaveTexto(v){
    return String(v).trim().toLowerCase()
      .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
      .replace(/\d+/g, function(d){ return d.length >= 12 ? d : ("000000000000"+d).slice(-12); });
  }
  function chaveDe(c, v){
    if (v == null || String(v).trim() === "") return null;
    if (c.tipo === "numero") return num(v);
    if (c.tipo === "data") return String(v).trim();
    return chaveTexto(v);
  }
  function carregarDados(){
    pagina = 0;                       // mudou filtro ou ordem: volta para a 1ª página
    dados = planilha.filtradas.slice();
    var alvos = [];
    ordens = ordens.filter(function(o){
      var c = acharCol(o.col);
      if (c) alvos.push({ c:c, dir:o.dir });
      return !!c;
    });
    if (!alvos.length) { desenhadas = 0; return; }
    var n = alvos.length, pares = new Array(dados.length);
    for (var i=0;i<dados.length;i++){
      var l = dados[i], ks = new Array(n);
      for (var j=0;j<n;j++) ks[j] = chaveDe(alvos[j].c, l[alvos[j].c.nome]);
      pares[i] = { l:l, k:ks, o:i };
    }
    pares.sort(function(a,b){
      for (var j=0;j<n;j++){
        var va = a.k[j], vb = b.k[j];
        if (va == null && vb == null) continue;
        if (va == null) return 1;
        if (vb == null) return -1;
        if (va < vb) return -alvos[j].dir;
        if (va > vb) return alvos[j].dir;
      }
      return a.o - b.o;
    });
    for (var m=0;m<pares.length;m++) dados[m] = pares[m].l;
    desenhadas = 0;
  }

  function celula(c, l){
    var k = cfg(c), v = l[c.nome], dentro;
    if (c.editavel) {
      var at = ' data-celula="' + l.__i + '" data-col="' + esc(c.nome) + '"';
      if (c.tipo === "opcao") {
        var ops = (c.opcoes || []).slice();
        if (v && ops.indexOf(v) < 0) ops.push(v);
        dentro = "<select" + at + '><option value=""></option>'
          + ops.map(function(o){ return "<option" + (o===v?" selected":"") + ">" + esc(o) + "</option>"; }).join("")
          + "</select>";
      } else {
        dentro = '<input type="' + (c.tipo === "data" ? "date" : "text") + '"' + at + ' value="' + esc(v) + '">';
      }
      return '<td class="edit' + (c.tipo === "numero" ? " num" : "") + '">' + dentro + "</td>";
    }
    var f = formatoDe(c), txt = textoDaCelula(c, v);
    var alinhaNum = (f === "int" || f === "moeda");
    var classe = alinhaNum ? ' class="num"' : "";

    if (f === "moeda" && k.barra) {          // desenho antigo da barra, se alguém religar
      var n = num(v);
      var pc = maxBarra > 0 && n != null ? Math.max(2, Math.min(100, (n/maxBarra)*100)) : 0;
      return '<td class="num"><span class="barra"><i style="width:' + pc + '%"></i>'
           + "<span>" + esc(txt) + "</span></span></td>";
    }
    if (chipDe(c) && v)
      return "<td" + classe + estiloCalor(c, v) + '><span class="cel"><span class="chip '
           + corChip(v) + '">' + esc(txt) + "</span></span></td>";
    if (k.longo && v)
      return '<td><span class="cel obs" data-ficha="' + l.__i + '">' + esc(txt) + "</span></td>";
    return "<td" + classe + estiloCalor(c, v) + '><span class="cel">' + esc(txt) + "</span></td>";
  }

  function escalas(){
    maxBarra = 0; maxCalor = {};
    var cb = null, quentes = [];
    vis.forEach(function(c){ if (cfg(c).barra) cb = c; if (calorDe(c)) quentes.push(c); });
    var base = fatia.length ? fatia : dados;
    for (var i = 0; i < base.length; i++) {
      var l = base[i];
      if (cb) { var a = num(l[cb.nome]); if (a != null && a > maxBarra) maxBarra = a; }
      for (var j = 0; j < quentes.length; j++) {
        var nm = quentes[j].nome, b = num(l[nm]);
        if (b != null && (maxCalor[nm] == null || b > maxCalor[nm])) maxCalor[nm] = b;
      }
    }
  }

  // corta a visão em páginas de POR_PAGINA linhas
  function fatiar(){
    totalPaginas = Math.max(1, Math.ceil(dados.length / POR_PAGINA));
    if (pagina >= totalPaginas) pagina = totalPaginas - 1;
    if (pagina < 0) pagina = 0;
    fatia = dados.length > POR_PAGINA
      ? dados.slice(pagina * POR_PAGINA, pagina * POR_PAGINA + POR_PAGINA)
      : dados;
  }

  function desenhar(continuar){
    if (!continuar) { $("corpo").innerHTML = ""; desenhadas = 0; fatiar(); escalas(); }
    var fim = Math.min(fatia.length, desenhadas + PASSO), html = "";
    for (var i = desenhadas; i < fim; i++) {
      var l = fatia[i], esq = 0;
      var classes = (selecao[l.__i] ? "sel " : "") + (l.__fora ? "fora" : "");
      html += '<tr data-i="' + l.__i + '"' + (classes.trim() ? ' class="' + classes.trim() + '"' : "") + ">";
      for (var j = 0; j < vis.length; j++) {
        var td = celula(vis[j], l);
        if (congelar && j < 2) {
          td = td.replace("<td", '<td style="left:' + esq + 'px" class="fixa' + (j===1?" borda-fixa":"") + '"')
                 .replace(/class="fixa([^"]*)" class="([^"]*)"/, 'class="fixa$1 $2"');
          esq += larguraDe(vis[j]);
        }
        html += td;
      }
      html += "</tr>";
    }
    desenhadas = fim;
    if (continuar) $("corpo").insertAdjacentHTML("beforeend", html);
    else $("corpo").innerHTML = html;
    $("vazio").style.display = dados.length ? "none" : "block";
    var falta = fatia.length - desenhadas;
    var m = $("corpo").querySelector(".linhaMais");
    if (m) m.remove();
    if (falta > 0)
      $("corpo").insertAdjacentHTML("beforeend",
        '<tr class="linhaMais"><td class="mais" colspan="' + vis.length + '">role para ver mais ' + falta + " linha(s)…</td></tr>");
    planilha.ligar($("corpo"));
    pintarStatus();
  }
  $("env").addEventListener("scroll", function(){
    var e = $("env");
    if (desenhadas < fatia.length && e.scrollTop + e.clientHeight > e.scrollHeight - 300) desenhar(true);
  });
  function pintarStatus(){
    $("statusLinhas").textContent = inteiro(dados.length);
    var mostrar = dados.length > POR_PAGINA;
    $("pag").style.display = mostrar ? "flex" : "none";
    if (!mostrar) return;
    var de  = pagina * POR_PAGINA + 1;
    var ate = Math.min(dados.length, de + POR_PAGINA - 1);
    $("pgTxt").textContent = inteiro(de) + "–" + inteiro(ate)
      + "  ·  página " + (pagina + 1) + " de " + totalPaginas;
    $("pgAnt").disabled  = pagina <= 0;
    $("pgProx").disabled = pagina >= totalPaginas - 1;
  }
  function irPara(p){
    if (p < 0 || p >= totalPaginas || p === pagina) return;
    $("pgAnt").disabled = $("pgProx").disabled = true;
    var de = p * POR_PAGINA;
    // baixa só os blocos dessa página, se ainda não vieram
    planilha.tela.pesado("Trazendo a página " + (p + 1), "de " + totalPaginas, function () {
      return planilha.garantirFaixa(de, de + POR_PAGINA).then(function () {
        pagina = p;
        desenhar();
        $("env").scrollTop = 0;
      });
    }).catch(function () {
      pintarStatus();                       // deu ruim na rede: devolve as setas
      toast("Não deu para trazer essa página. Tente de novo.", true);
    });
  }

  $("corpo").addEventListener("click", function(ev){
    var ficha = ev.target.closest("[data-ficha]");
    if (ficha) { abrirFicha(+ficha.getAttribute("data-ficha")); return; }
    if (ev.target.closest("input,select")) return;
    var tr = ev.target.closest("tr[data-i]");
    if (!tr) return;
    var i = +tr.getAttribute("data-i");
    if (ev.shiftKey && ultimaLinha != null) {
      var a = fatia.findIndex(function(l){ return l.__i === ultimaLinha; });
      var b = fatia.findIndex(function(l){ return l.__i === i; });
      if (a >= 0 && b >= 0) for (var k = Math.min(a,b); k <= Math.max(a,b); k++) selecao[fatia[k].__i] = true;
    } else if (ev.ctrlKey || ev.metaKey) selecao[i] = !selecao[i];
    else { selecao = {}; selecao[i] = true; }
    ultimaLinha = i;
    $("corpo").querySelectorAll("tr[data-i]").forEach(function(r){
      r.classList.toggle("sel", !!selecao[+r.getAttribute("data-i")]);
    });
    pintarStatus();
    if (!ev.ctrlKey && !ev.metaKey && !ev.shiftKey) abrirFicha(i);
  });

  $("corpo").addEventListener("keydown", function(ev){
    var el = ev.target;
