<script>

(function () {
  "use strict";
  if (window.__MODO !== "ger") return;


  /* =======================================================================
     O QUE VOCÊ PODE MEXER SEM MEDO
     ======================================================================= */

  // Onde as listas NOVAS nascem (subject da anotação = PREFIXO + apelido).
  var PREFIXO_NOVO = "LISTASCOORDPE::";

  // Tudo que o gerenciador mostra. O primeiro é o de cima; os outros são o legado.
  var PREFIXOS = ["LISTASCOORDPE::", "LISTACOORDPE::", "CESDADOS::"];

  // Para onde vão os botões de cada cartão, por prefixo. {slug} vira o apelido da lista.
  // Começando com "?" o link fica na própria casca (esta mesma web resource).
  // A lista abre nesta mesma página, só com o apelido no endereço.
  var LINKS = {
    "LISTASCOORDPE::": "?page=" + PAGINA + "&l={slug}",
    "LISTACOORDPE::":  "?page=" + PAGINA + "&l={slug}",
    "CESDADOS::":      "?page=" + PAGINA + "&l={slug}"
  };

  // Símbolo no quadrado laranja do topo (caminho de imagem ou base64). Vazio = só o quadrado.
  var LOGO = "";

  /* ======================================================================= */

  var API  = "/api/data/v9.2";
  var CAB  = { "OData-Version":"4.0", "Content-Type":"application/json", "Accept":"application/json",
               "OData-MaxVersion":"4.0" };
  var PEDACO = 3000000;      // tamanho máximo de cada pedaço, em base64 (igual ao criador)
  var $ = function (i) { return document.getElementById(i); };

  var listas = [], filtro = "", ordem = "recentes";

  /* ---------- utilidades ---------- */
  function esc(s){
    return String(s == null ? "" : s).replace(/[&<>"]/g, function(c){
      return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c];
    });
  }
  // Codifica em pedaços de tamanho múltiplo de 3 e concatena o base64 já pronto.
  // Saída idêntica à de antes, mas sem segurar uma string binária de dezenas de MB
  // na memória enquanto a lista inteira é serializada.
  function toB64(str){
    var b = new TextEncoder().encode(str), out = "", CH = 98304;   // 98304 = 3 x 32768
    for (var i = 0; i < b.length; i += CH) {
      var fim = Math.min(b.length, i + CH), s = "";
      for (var j = i; j < fim; j += 0x8000)
        s += String.fromCharCode.apply(null, b.subarray(j, Math.min(fim, j + 0x8000)));
      out += btoa(s);
    }
    return out;
  }
  function deB64(b64){
    var bin = atob(b64), b = new Uint8Array(bin.length);
    for (var i = 0; i < bin.length; i++) b[i] = bin.charCodeAt(i);
    return new TextDecoder().decode(b);
  }
  function inteiro(n){ return (n == null ? 0 : n).toLocaleString("pt-BR", {maximumFractionDigits:0}); }
  function peso(bytes){
    if (bytes == null) return "—";
    if (bytes >= 1048576) return (bytes/1048576).toLocaleString("pt-BR",{maximumFractionDigits:1}) + " MB";
    if (bytes >= 1024)    return Math.round(bytes/1024).toLocaleString("pt-BR") + " KB";
    return bytes + " B";
  }
  function quando(iso){
    if (!iso) return "—";
    var d = new Date(iso);
    if (isNaN(d)) return "—";
    var p = function(n){ return (n<10?"0":"") + n; };
    return p(d.getDate()) + "/" + p(d.getMonth()+1) + "/" + d.getFullYear()
         + " às " + p(d.getHours()) + ":" + p(d.getMinutes());
  }
  function agora(){ return new Date().toISOString(); }
  // "Carteira PJ — setembro" -> "carteira-pj-setembro". Se já existir, vira -2, -3…
  function apelido(titulo){
    var base = String(titulo || "lista").toLowerCase()
      .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "")
      .slice(0, 44).replace(/-+$/, "");
    if (!base) base = "lista";
    var usados = {};
    listas.forEach(function(L){ usados[String(L.slug).toLowerCase()] = true; });
    var s = base, n = 2;
    while (usados[s]) { s = base + "-" + n; n++; }
    return s;
  }
  function versao(){ return Math.random().toString(36).slice(2, 15); }
  // tamanho em base64 sem precisar codificar (o campo do Dataverse conta o base64)
  function tamanhoB64(txt){
    var bytes = new TextEncoder().encode(String(txt || "")).length;
    return Math.ceil(bytes / 3) * 4;
  }
  var TETO_B64 = 5242880;   // teto do campo de arquivo da anotação

  function aviso(txt, ruim){
    var t = $("toast");
    t.textContent = txt;
    t.className = "toast on" + (ruim ? " ruim" : "");
    clearTimeout(aviso._t);
    aviso._t = setTimeout(function(){ t.className = "toast"; }, ruim ? 6000 : 3000);
  }

  (function pintarSelo(){
    var el = $("selo");
    if (!el || !LOGO) return;
    el.innerHTML = '<img src="' + LOGO + '" alt="">';
    el.classList.add("comLogo");
    el.querySelector("img").onerror = function(){ el.innerHTML = ""; el.classList.remove("comLogo"); };
  })();

  /* ---------- conversa com o Dataverse ---------- */
  function chamar(caminho, opcoes){
    opcoes = opcoes || {};
    opcoes.headers = Object.assign({}, CAB, opcoes.headers || {});
    opcoes.credentials = "include";
    return fetch(API + caminho, opcoes).then(function(r){
      if (r.status === 204) return null;
      return r.text().then(function(t){
        var j = null;
        try { j = t ? JSON.parse(t) : null; } catch (e) {}
        if (!r.ok) {
          var m = (j && j.error && j.error.message) || ("HTTP " + r.status);
          throw new Error(m);
        }
        return j;
      });
    });
  }

  // Junta os registros de todos os prefixos e agrupa os pedaços (#1, #2…) em uma lista só.
  function buscarListas(){
    var partes = PREFIXOS.map(function(p){ return "startswith(subject,'" + p + "')"; });
    var filtroOData = "(" + partes.join(" or ") + ")";
    var url = "/annotations?$select=annotationid,subject,filename,notetext,filesize,modifiedon"
            + "&$filter=" + encodeURIComponent(filtroOData)
            + "&$orderby=modifiedon desc&$top=1000";
    return chamar(url).then(function(j){
      var todos = (j && j.value) || [];
      var mapa = {};
      todos.forEach(function(r){
        var s = String(r.subject || "");
        var pre = "";
        for (var i = 0; i < PREFIXOS.length; i++)
          if (s.indexOf(PREFIXOS[i]) === 0) { pre = PREFIXOS[i]; break; }
        var resto = s.slice(pre.length);
        var corte = resto.indexOf("#");
        var slug  = corte < 0 ? resto : resto.slice(0, corte);
        var nPed  = corte < 0 ? 0 : (parseInt(resto.slice(corte + 1), 10) || 0);
        var ch = pre + slug;
        if (!mapa[ch]) mapa[ch] = { prefixo:pre, slug:slug, pedacos:[], bytes:0, modificado:null, meta:{} };
        var L = mapa[ch];
        L.pedacos.push({ id:r.annotationid, n:nPed, bytes:r.filesize || 0 });
        L.bytes += (r.filesize || 0);
        if (!L.modificado || r.modifiedon > L.modificado) L.modificado = r.modifiedon;
        if (nPed === 0) {
          L.id = r.annotationid;
          L.arquivo = r.filename;
          try { L.meta = JSON.parse(r.notetext || "{}") || {}; } catch (e) { L.meta = {}; }
        }
      });
      return Object.keys(mapa).map(function(k){
        var L = mapa[k];
        L.pedacos.sort(function(a,b){ return a.n - b.n; });
        L.titulo  = L.meta.t || L.slug;
        L.colunas = L.meta.nc == null ? null : +L.meta.nc;
        L.linhas  = L.meta.nl == null ? null : +L.meta.nl;
        L.temHtml = L.meta.h === 1;
        L.cifrada = L.meta.c === 1;
        L.partes  = L.meta.p || L.pedacos.length;
        return L;
      }).filter(function(L){ return !!L.slug && !!L.id; });
    });
  }

  // Baixa e remonta o JSON completo de uma lista (junta os pedaços na ordem).
  function lerLista(L){
    var ids = L.pedacos.map(function(p){ return p.id; });
    var b64 = new Array(ids.length);
    var fila = Promise.resolve();
    ids.forEach(function(id, i){
      fila = fila.then(function(){
        return chamar("/annotations(" + id + ")?$select=documentbody,notetext").then(function(r){
          b64[i] = (r && r.documentbody) || "";
        });
      });
    });
    return fila.then(function(){
      var txt = deB64(b64.join(""));
      return JSON.parse(txt);
    });
  }

  // Grava o JSON completo de volta, refazendo os pedaços e limpando os que sobraram.
  function gravarLista(L, obj){
    var b64 = toB64(JSON.stringify(obj));
    var blocos = [];
    for (var i = 0; i < b64.length; i += PEDACO) blocos.push(b64.slice(i, i + PEDACO));
    if (!blocos.length) blocos = [""];

    var v = versao();
    var nota = JSON.stringify({
      t: obj.titulo || L.slug,
      nc: (obj.colunas || []).length,
      nl: (obj.linhas || []).length,
      p: blocos.length,          // quantos pedaços esta lista tem
      h: obj.pagina ? 1 : 0,     // tem HTML próprio?
      v: v
    });

    var fila = Promise.resolve();
    blocos.forEach(function(b, i){
      var subject = L.prefixo + L.slug + (i ? "#" + i : "");
      var arquivo = L.slug + (i ? "-" + i : "") + ".json";
      var corpo = { subject:subject, filename:arquivo, mimetype:"application/json",
                    documentbody:b, notetext: i ? JSON.stringify({p:i, v:v}) : nota };
      var existente = null;
      for (var k = 0; k < L.pedacos.length; k++) if (L.pedacos[k].n === i) existente = L.pedacos[k];
      fila = fila.then(function(){
        if (existente)
          return chamar("/annotations(" + existente.id + ")", { method:"PATCH", body:JSON.stringify(corpo) });
        return chamar("/annotations", { method:"POST", body:JSON.stringify(corpo) });
      });
    });

    // pedaços que não são mais necessários
    L.pedacos.forEach(function(p){
      if (p.n >= blocos.length) fila = fila.then(function(){
        return chamar("/annotations(" + p.id + ")", { method:"DELETE" });
      });
    });
    return fila;
  }

  // Lista nova já nasce PROTEGIDA (a proteção é obrigatória): cabeçalho no formato
  // de blocos, cifrado com AES-256 e uma chave nova. A chave fica neste navegador e
  // vai no link do botão "Abrir"/"Copiar link" — igual ao que a lista faz sozinha.
  var GUARDA_CHAVE = "listaCoordPE:chave:";
  function paraB64url(u8){
    var s = ""; for (var i = 0; i < u8.length; i++) s += String.fromCharCode(u8[i]);
    return btoa(s).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
  }
  var COMPACTA = typeof CompressionStream === "function" && typeof DecompressionStream === "function";
  function cifrarTexto(txt, bytesChave){
    var iv = crypto.getRandomValues(new Uint8Array(12)), claro = new TextEncoder().encode(txt), chaveC;
    return crypto.subtle.importKey("raw", bytesChave, { name:"AES-GCM" }, false, ["encrypt"])
      .then(function (k) {
        chaveC = k;
        if (!COMPACTA) return claro;
        return new Response(new Blob([claro]).stream().pipeThrough(new CompressionStream("gzip")))
          .arrayBuffer().then(function (ab) { return new Uint8Array(ab); });
      }).then(function (dado) {
        return crypto.subtle.encrypt({ name:"AES-GCM", iv: iv }, chaveC, dado);
      }).then(function (ct) {
        var c = new Uint8Array(ct), out = new Uint8Array(16 + c.length);
        out.set([76, 67, 80, COMPACTA ? 50 : 49], 0); out.set(iv, 4); out.set(c, 16);    // "LCP2"/"LCP1" + iv + cifra
        var s = "";
        for (var i = 0; i < out.length; i += 0x8000) s += String.fromCharCode.apply(null, out.subarray(i, i + 0x8000));
        return btoa(s);
      });
  }
  function criarLista(titulo, html){
    var slug = apelido(titulo);
    var cab = { formato:"blocos", porBloco:8000, blocos:0, total:0, versao:1,
                criada: agora(), titulo: titulo, colunas: [], atualizadoEm: agora() };
    if (html) cab.pagina = html;
    var bytes = crypto.getRandomValues(new Uint8Array(32)), kTxt = paraB64url(bytes);
    try { localStorage.setItem(GUARDA_CHAVE + slug, kTxt); } catch (e) {}
    return cifrarTexto(JSON.stringify(cab), bytes).then(function (b64) {
      var corpo = { subject: PREFIXO_NOVO + slug, filename: slug + ".json", mimetype: "application/json",
                    documentbody: b64,
                    notetext: JSON.stringify({ t: titulo, nc: 0, nl: 0, p: 1, h: html ? 1 : 0, v: versao(), c: 1 }) };
      return chamar("/annotations", { method:"POST", body: JSON.stringify(corpo) });
    }).then(function () { return slug; });
  }

  function excluirLista(L){
    var fila = Promise.resolve();
    L.pedacos.forEach(function(p){
      fila = fila.then(function(){ return chamar("/annotations(" + p.id + ")", { method:"DELETE" }); });
    });
    return fila;
  }

  /* ---------- desenho da tela ---------- */
  function linkDe(L){
    var m = LINKS[L.prefixo] || LINKS[PREFIXO_NOVO] || "";
    var u = String(m).replace(/\{slug\}/g, encodeURIComponent(L.slug));
    // lista protegida que este navegador já abriu: o link leva a chave junto
    var k = chaveDe(L.slug);
    return k && L.cifrada ? u + "#k=" + k : u;
  }
  function linkCheio(L){
    var u = linkDe(L);
    if (u.charAt(0) === "?") return location.origin + location.pathname + u;
    return location.origin + u;
  }

  function visiveis(){
    var q = filtro.trim().toLowerCase()
      .normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    var arr = listas.filter(function(L){
      if (!q) return true;
      var alvo = (L.titulo + " " + L.slug).toLowerCase()
        .normalize("NFD").replace(/[\u0300-\u036f]/g, "");
      return alvo.indexOf(q) >= 0;
    });
    arr.sort(function(a, b){
      if (ordem === "nome")    return a.titulo.localeCompare(b.titulo, "pt-BR");
      if (ordem === "linhas")  return (b.linhas || 0) - (a.linhas || 0);
      if (ordem === "peso")    return (b.bytes || 0) - (a.bytes || 0);
      if (ordem === "antigas") return String(a.modificado).localeCompare(String(b.modificado));
      return String(b.modificado).localeCompare(String(a.modificado));
    });
    return arr;
  }

  function desenhar(){
    var arr = visiveis();
    $("grade").innerHTML = arr.map(function(L, i){
      var selos = [];
      selos.push('<span class="chip a">' + (L.linhas == null ? "?" : inteiro(L.linhas)) + " linha(s)</span>");
      selos.push('<span class="chip">' + (L.colunas == null ? "?" : L.colunas) + " coluna(s)</span>");
      if (L.temHtml) selos.push('<span class="chip b">html próprio</span>');
      if (L.cifrada && !chaveDe(L.slug))
        selos.push('<span class="chip b" title="Protegida em outro navegador: abra uma vez pelo link do time para o link sair daqui com a chave">protegida · sem a chave aqui</span>');
      else selos.push(L.cifrada ? '<span class="chip c">protegida</span>'
                                : '<span class="chip d">sem proteção</span>');
      if (L.pedacos.length > 1) selos.push('<span class="chip">' + L.pedacos.length + " pedaços</span>");
      if (L.prefixo !== PREFIXO_NOVO) selos.push('<span class="chip d">legado</span>');
      return '<div class="cartao" data-c="' + i + '">'
        + "<div>"
        +   "<h3>" + esc(L.titulo) + "</h3>"
        +   '<div class="slug">' + esc(L.prefixo + L.slug) + "</div>"
        + "</div>"
        + '<div class="selos">' + selos.join("") + "</div>"
        + '<div class="quando">Atualizada em ' + esc(quando(L.modificado)) + " · " + esc(peso(L.bytes)) + "</div>"
        + '<div class="acoes">'
        +   '<button class="pri mini" data-abrir="' + i + '">Abrir</button>'
        +   '<button class="mini" data-link="' + i + '">Copiar link</button>'
        +   '<span class="vaga"></span>'
        +   '<button class="mini perigo" data-excluir="' + i + '">Excluir</button>'
        + "</div>"
        + "</div>";
    }).join("");

    $("vazio").style.display = arr.length ? "none" : "block";
    if (arr.length === 0 && listas.length > 0)
      $("vazio").innerHTML = "<b>Nada com esse texto.</b>Tente outro pedaço do nome.";

    var totalLinhas = 0, totalBytes = 0;
    listas.forEach(function(L){ totalLinhas += (L.linhas || 0); totalBytes += (L.bytes || 0); });
    $("cLista").textContent  = inteiro(listas.length);
    $("cLinha").textContent  = inteiro(totalLinhas);
    $("cPeso").textContent   = peso(totalBytes) + " guardados";
    $("cCarimbo").textContent = "visto em " + quando(agora());

    ligarCartoes(arr);
  }

  function ligarCartoes(arr){
    function cada(attr, fn){
      $("grade").querySelectorAll("[data-" + attr + "]").forEach(function(b){
        b.onclick = function(ev){
          ev.stopPropagation();
          fn(arr[+b.getAttribute("data-" + attr)], b);
        };
      });
    }
    cada("abrir",  function(L){ window.open(linkDe(L), "_blank"); });
    cada("link",   function(L){
      var url = linkCheio(L);
      var ok = function(){ aviso("Link do time copiado."); };
      if (navigator.clipboard && navigator.clipboard.writeText)
        navigator.clipboard.writeText(url).then(ok, function(){ pedirCopia(url); });
      else pedirCopia(url);
    });
    cada("excluir", janelaExcluir);
  }

  function pedirCopia(url){
    abrirJanela({
      titulo: "Copie o link",
      sub: "O navegador não deixou copiar sozinho.",
      miolo: '<input id="campoLink" value="' + esc(url) + '" readonly>',
      botoes: [{ rotulo:"Fechar", fecha:true }]
    });
    var c = $("campoLink"); if (c) { c.focus(); c.select(); }
  }

  /* ---------- janelas ---------- */
  function abrirJanela(cfg){
    $("janTit").textContent = cfg.titulo || "";
    $("janSub").textContent = cfg.sub || "";
    $("janMiolo").innerHTML = cfg.miolo || "";
    $("janPe").innerHTML = "";
    (cfg.botoes || []).forEach(function(b, i){
      var el = document.createElement("button");
      el.textContent = b.rotulo;
      if (b.classe) el.className = b.classe;
      el.onclick = function(){
        if (b.fecha) { fecharJanela(); return; }
        if (b.acao) b.acao(el);
      };
      el.id = "janBt" + i;
      $("janPe").appendChild(el);
    });
    $("jan").classList.add("on");
    $("fundo").classList.add("on");
  }
  function fecharJanela(){ $("jan").classList.remove("on"); $("fundo").classList.remove("on"); }
  $("fundo").onclick = fecharJanela;
  document.addEventListener("keydown", function(e){ if (e.key === "Escape") fecharJanela(); });

  function janelaExcluir(L){
    var muitas = (L.linhas || 0) > 0;
    abrirJanela({
      titulo: "Excluir “" + L.titulo + "”?",
      sub: L.prefixo + L.slug,
      miolo: '<div class="aviso">Isso apaga a lista inteira: '
           + inteiro(L.linhas || 0) + " linha(s), " + (L.colunas || 0) + " coluna(s)"
           + (L.temHtml ? " e o HTML da página" : "")
           + ". Não dá para desfazer — se quiser, baixe o backup antes.</div>"
           + (muitas
              ? '<label for="campoConf">Para confirmar, escreva <code>EXCLUIR</code></label>'
                + '<input id="campoConf" placeholder="EXCLUIR" autocomplete="off">'
              : ""),
      botoes: [
        { rotulo:"Cancelar", fecha:true },
        { rotulo:"Excluir", classe:"perigo", acao:function(bt){
            if (muitas && ($("campoConf").value || "").trim().toUpperCase() !== "EXCLUIR") {
              aviso("Escreva EXCLUIR para confirmar.", true); return;
            }
            bt.disabled = true; bt.textContent = "Excluindo…";
            excluirLista(L).then(function(){
              fecharJanela(); aviso("Lista excluída."); carregar();
            }).catch(function(e){
              bt.disabled = false; bt.textContent = "Excluir";
              aviso("Não deu para excluir: " + e.message, true);
            });
          } }
      ]
    });
  }

  function janelaNova(){
    abrirJanela({
      titulo: "Nova lista",
      sub: "Nasce vazia, em " + PREFIXO_NOVO + " — os dados entram depois, no editor.",
      miolo: '<label for="campoNova">Nome da lista</label>'
           + '<input id="campoNova" placeholder="Ex.: Carteira PJ — setembro" maxlength="80">'
           + '<label for="campoHtml">HTML da página (o desenho da lista)</label>'
           + '<textarea id="campoHtml" spellcheck="false" '
           + 'placeholder="Cole aqui o HTML/CSS/JS da página. Pode deixar vazio e colar depois no editor."></textarea>'
           + '<div class="conta" id="contaHtml"><span>Deixe em branco para usar o visual padrão.</span><b>0</b></div>',
      botoes: [
        { rotulo:"Cancelar", fecha:true },
        { rotulo:"Criar lista", classe:"pri", acao:function(bt){
            var nome = ($("campoNova").value || "").trim();
            var html = $("campoHtml").value || "";
            if (!nome) { aviso("Escreva um nome.", true); return; }
            if (tamanhoB64(html) > TETO_B64) { aviso("Esse HTML passou do teto do campo.", true); return; }
            bt.disabled = true; bt.textContent = "Criando…";
            criarLista(nome, html.trim()).then(function(slug){
              fecharJanela(); aviso("Lista criada.");
              carregar();
            }).catch(function(e){
              bt.disabled = false; bt.textContent = "Criar lista";
              aviso("Não deu para criar: " + e.message, true);
            });
          } }
      ]
    });
    var ta = $("campoHtml"), conta = $("contaHtml");
    function medir(){
      var b = tamanhoB64(ta.value);
      conta.querySelector("b").textContent = inteiro(b) + " de " + inteiro(TETO_B64);
      conta.classList.toggle("cheio", b > TETO_B64);
    }
    ta.addEventListener("input", medir);
    medir();
    var c = $("campoNova"); if (c) c.focus();
  }

  /* ---------- carga ---------- */
  function carregar(){
    $("erro").style.display = "none";
    if (!listas.length) $("carregando").style.display = "block";
    return buscarListas().then(function(arr){
      listas = arr;
      $("carregando").style.display = "none";
      desenhar();
    }).catch(function(e){
      $("carregando").style.display = "none";
      $("erro").style.display = "block";
      $("erro").textContent = "Não deu para ler as listas: " + e.message
        + " — confira se você está logado no Dynamics nesta mesma aba.";
    });
  }

  var tBusca = null;
  $("busca").addEventListener("input", function(){
    var v = this.value;
    clearTimeout(tBusca);
    tBusca = setTimeout(function(){ filtro = v; desenhar(); }, 180);
  });
  $("ordem").onchange = function(){ ordem = this.value; desenhar(); };
  $("btAtualizar").onclick = function(){
    var bt = this; bt.disabled = true; bt.textContent = "Atualizando…";
    carregar().then(function(){ bt.disabled = false; bt.textContent = "Atualizar"; return protegerTodas(); });
  };
  $("btNova").onclick = janelaNova;

  /* ---------- proteção obrigatória: todas as listas, as antigas também ----------
     Assim que quem cuida das listas entra aqui, toda lista ainda sem proteção é
     cifrada (AES-256) com uma chave nova, que fica neste navegador e vai no link
     de "Abrir" / "Copiar link" / "Copiar links do time". Lista no formato antigo
     (um JSON só, fatiado) já sai no formato de blocos.                          */
  function chaveDe(slug){ try { return localStorage.getItem(GUARDA_CHAVE + slug) || ""; } catch (e) { return ""; } }
  function ehCifrado(b64){
    if (!b64 || b64.length < 8) return false;
    try { var m = atob(b64.slice(0, 8)).slice(0, 4); return m === "LCP1" || m === "LCP2"; } catch (e) { return false; }
  }
  function deB64url(t){
    t = String(t).replace(/-/g, "+").replace(/_/g, "/");
    while (t.length % 4) t += "=";
    var bin = atob(t), u8 = new Uint8Array(bin.length);
    for (var i = 0; i < bin.length; i++) u8[i] = bin.charCodeAt(i);
    return u8;
  }
  function telaG(tit, sub, pc){
    var c = $("capa");
    c.className = "capa" + (pc != null ? " comPc" : "");
    $("capaTit").textContent = tit || ""; $("capaSub").textContent = sub || "";
    if (pc != null) { var n = Math.round(pc); $("capaPc").style.width = n + "%"; $("capaNum").textContent = n + "%"; }
  }
  function telaGFora(){ $("capa").className = "capa off"; }

  function lerCorpo(id){
    return chamar("/annotations(" + id + ")?$select=documentbody").then(function (r) {
      return { b64: (r && r.documentbody) || "", etag: r && r["@odata.etag"] };
    });
  }
  function patchCorpo(id, corpo, etag){
    var op = { method:"PATCH", body: JSON.stringify(corpo) };
    if (etag) op.headers = { "If-Match": etag };
    return chamar("/annotations(" + id + ")", op);
  }
  // cifra um registro que ainda está em texto; se alguém gravou no meio (412), lê de novo
  function cifrarRegistro(id, bytes, extra){
    var tentativas = 0;
    function passo(){
      return lerCorpo(id).then(function (r) {
        if (ehCifrado(r.b64) || !r.b64) return;
        return cifrarTexto(deB64(r.b64), bytes).then(function (novo) {
          var corpo = Object.assign({ documentbody: novo }, extra || {});
          return patchCorpo(id, corpo, r.etag);
        });
      }).catch(function (e) {
        if (/412|precondition/i.test(String(e && e.message)) && tentativas < 3) { tentativas++; return passo(); }
        throw e;
      });
    }
    return passo();
  }
  function notaCifrada(L, extra){
    return JSON.stringify(Object.assign({}, L.meta || {}, extra || {}, { c: 1, v: versao() }));
  }

  function protegerLista(L, aoAndar){
    var kTxt = chaveDe(L.slug) || paraB64url(crypto.getRandomValues(new Uint8Array(32)));
    var bytes = deB64url(kTxt);
    try { localStorage.setItem(GUARDA_CHAVE + L.slug, kTxt); } catch (e) {}   // guarda ANTES de gravar
    var ped = L.pedacos.slice().sort(function (a, b) { return a.n - b.n; });
    var cab0 = ped[0];
    return lerCorpo(cab0.id).then(function (r0) {
      if (ehCifrado(r0.b64)) return patchCorpo(cab0.id, { notetext: notaCifrada(L) });   // só faltava o selo
      var cab = null;
      try { cab = JSON.parse(deB64(r0.b64)); } catch (e) {}
      if (cab && cab.formato === "blocos") {
        // formato novo: cifra bloco por bloco e o cabeçalho por último
        var fila = Promise.resolve(), feitos = 0, total = ped.length;
        ped.forEach(function (p) {
          if (p.n === 0) return;
          fila = fila.then(function () {
            return cifrarRegistro(p.id, bytes).then(function () { feitos++; aoAndar(feitos, total); });
          });
        });
        return fila.then(function () {
          return cifrarRegistro(cab0.id, bytes, { notetext: notaCifrada(L) });
        }).then(function () { aoAndar(total, total); });
      }
      return converterAntiga(L, ped, bytes, aoAndar);
    });
  }

  // formato antigo: os pedaços são fatias de um JSON só -> vira cabeçalho + blocos cifrados
