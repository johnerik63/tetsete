  function salvarAdm(bt){
    var vivas = estrutura.filter(function (e) { return !e.apagar; });
    if (!vivas.length) { $("admInfo").textContent = "Precisa sobrar pelo menos uma coluna."; return; }
    var chave = vivas.filter(function (e) { return e.chave; })
                     .map(function (e) { return String(e.nome || e.id).trim(); });
    if (!chave.length) {
      $("admInfo").textContent = "Marque pelo menos uma coluna em Chave — é por ela que a carga nova sabe qual linha é qual.";
      return;
    }
    // não mexeu na chave padrão (CNPJ + contrato): continua no padrão, que também
    // aceita cnpj/contrato como reserva quando cnpj_completo/numero_de_contrato vierem vazios
    var padrao = planilha.chavePadrao ? planilha.chavePadrao() : [];
    if (padrao.length && chave.length === padrao.length && chave.every(function (n) { return padrao.indexOf(n) >= 0; }))
      chave = [];
    var vistos = {}, repetido = null;
    vivas.forEach(function (e) {
      var n = String(e.nome || e.id).trim().toLowerCase();
      if (vistos[n]) repetido = n;
      vistos[n] = 1;
    });
    if (repetido) {
      $("admInfo").textContent = 'Duas colunas com o nome "' + repetido + '". Os nomes precisam ser diferentes.';
      return;
    }
    bt.disabled = true; bt.textContent = "Aplicando…";
    var defs = vivas.map(function (e) {
      return { id:e.id, nome:String(e.nome || e.id).trim(), tipo:e.tipo,
               opcoes: e.tipo === "opcao" ? e.opcoes.slice() : null,
               filtro: e.filtro, filtroTipo: e.filtro ? e.filtroTipo : "",
               editavel: e.editavel, origem: e.origem,
               formato: e.formato || "", chip: !!e.chip,
               calor: e.calor || "", calorOrdem: e.calor ? e.calorOrdem : "" };
    });
    planilha.aplicarEstrutura(defs, ($("admTitulo").value || "").trim(), chave).then(function () {
      larguras = {}; medidas = {}; medidoCom = -1;
      gravarPref();
      montarColunas(); medirColunas(); montarCabecalho(); carregarDados(); desenhar();
      bt.disabled = false; bt.textContent = "Aplicar e salvar";
      fecharAdm();
    });
  }

  /* ---------- a senha que destranca o quadrado laranja ----------
     É a mesma do gerenciador: fica em SENHA_ADMIN, no primeiro <script> da página. */
  var CHAVE_SENHA = "listaCoordPE:admin";
  var SENHA_HASH = SENHA_ADMIN.hash, hashDaSenha = hashSenhaAdmin;
  planilha.hashDaSenha = hashSenhaAdmin;
  function liberado(){
    try { return sessionStorage.getItem(CHAVE_SENHA) === "1"; } catch (e) { return false; }
