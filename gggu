      bt = bt || { rotulo:"Tentar de novo", acao:function () { location.reload(); } };
      $("capaErro").innerHTML = '<button class="pri" type="button" id="capaBt">' + esc(bt.rotulo) + "</button>";
      $("capaBt").onclick = bt.acao;
    }
    // espera a tela ser desenhada antes de começar um trabalho que trava a aba
    function depoisDoQuadro(){
      return new Promise(function (ok) {
        var foi = false;
        function vai(){ if (foi) return; foi = true; setTimeout(ok, 0); }
        if (window.requestAnimationFrame) requestAnimationFrame(vai);
        setTimeout(vai, 80);
      });
