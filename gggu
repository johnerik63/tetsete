  /* ---------- porta: o gerenciador pede a senha de quem cuida das listas ---------- */
  var CHAVE_SENHA = "listaCoordPE:admin";
  function liberado(){ try { return sessionStorage.getItem(CHAVE_SENHA) === "1"; } catch (e) { return false; } }
  function entrar(){
