  // Se true, o merge só regrava no Dataverse os blocos que realmente mudaram.
  // Deixe false para voltar ao comportamento antigo (regrava a lista inteira).
  var GRAVAR_SO_MUDADO = true;
  var aoProgredir = null;

  // Roda um laço pesado em fatias, devolvendo o controle para a tela entre uma
  // fatia e outra — a aba continua respondendo e dá para mostrar porcentagem.
  function emFatias(total, tamanho, passo, aoAndar){
    return new Promise(function (ok, falha) {
      var i = 0;
      function volta(){
        var fim = Math.min(total, i + tamanho);
        try { passo(i, fim); } catch (e) { falha(e); return; }
        i = fim;
        if (aoAndar) { try { aoAndar(i, total); } catch (e) {} }
        if (i >= total) { ok(); return; }
        setTimeout(volta, 0);
      }
      volta();
    });
  }

  // Roda as tarefas de N em N, para não abrir 36 conexões de uma vez.
  function emLotes(tarefas, quantas){
    var i = 0;
    function proxima(){
      if (i >= tarefas.length) return Promise.resolve();
      var t = tarefas[i++];
      return t().then(proxima);
    }
    var trilhas = [];
    for (var k = 0; k < Math.min(quantas, tarefas.length); k++) trilhas.push(proxima());
    return Promise.all(trilhas);
  }

  function baixarTudo(achados){
    var b64 = new Array(achados.length), prontos = 0;
    var tarefas = achados.map(function (a, i) {
      return function () {
        return chamar("/annotations(" + a.id + ")?$select=documentbody").then(function (r) {
          b64[i] = (r && r.documentbody) || "";
          prontos++;
          if (achados.length > 1)
            tela.pc(prontos / achados.length * 100, "baixando " + prontos + " de " + achados.length + " pedaços");
        });
      };
    });
    return emLotes(tarefas, 6).then(function () {
      tela.pc(null, "montando a lista…");
      return montarDoc(b64, achados);
    });
