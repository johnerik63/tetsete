      saida[i - de] = o;
    }
    return saida;
  }
  // renomear coluna: troca a chave em todas as linhas
  function renomearChave(de, para){
    if (de === para) return;
    var linhas = doc.linhas || [];
    for (var i = 0; i < linhas.length; i++) {
      var l = linhas[i];
      if (!l) continue;
      if (l[de] !== undefined) { l[para] = l[de]; delete l[de]; }
      if (l.__b !== undefined) delete l.__b;
      if (l.__k !== undefined) delete l.__k;
    }
