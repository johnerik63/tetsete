<script>
/* ---------- qual das duas telas abrir ----------
   sem "l" no endereço  -> gerenciador de listas
   com "l"              -> a lista daquele apelido                       */
var PAGINA = new URLSearchParams(location.search).get("page") || "listas";

/* ---------- a senha de quem cuida das listas ----------
   Vale para entrar no gerenciador E no quadrado laranja de cada lista.
   Aqui fica só o "hash" (PBKDF2-SHA256, 200 mil voltas), que não dá para desfazer.
   Maiúscula e minúscula não fazem diferença.
   PARA TROCAR: abra qualquer tela, aperte F12 > Console e rode
       hashSenhaAdmin("SENHA NOVA").then(console.log)
   cole o resultado em SENHA_ADMIN.hash e publique de novo.
   Senha curta cai rápido num ataque de tentativa e erro — prefira 10+ caracteres. */
var SENHA_ADMIN = { hash: "c06abcad9d89a24cb661d529fa252454210fb8e684f3655364abd030efb4a871",
                    sal: "listaCoordPE:admin:v1", voltas: 200000 };
function hashSenhaAdmin(txt){
  var enc = new TextEncoder();
  return crypto.subtle.importKey("raw", enc.encode(String(txt || "").trim().toUpperCase()),
                                 "PBKDF2", false, ["deriveBits"])
    .then(function (k) {
      return crypto.subtle.deriveBits({ name:"PBKDF2", hash:"SHA-256",
        salt: enc.encode(SENHA_ADMIN.sal), iterations: SENHA_ADMIN.voltas }, k, 256);
    }).then(function (bits) {
      return Array.prototype.map.call(new Uint8Array(bits), function (b) {
        return (b < 16 ? "0" : "") + b.toString(16); }).join("");
    });
}
(function () {
  var temL = !!new URLSearchParams(location.search).get("l");
  window.__MODO = temL ? "lista" : "ger";
  document.body.className = "modo-" + window.__MODO;
  var fora = document.getElementById(temL ? "appGer" : "appLista");
  if (fora) fora.remove();
  if (!temL) { var c = document.getElementById("capa"); if (c) c.classList.add("off"); }
})();
</script>

