    colar: function () { garantirTudo().then(janelaColar); },
    garantirTudo: garantirTudo,
    porPagina: POR_PAGINA,
    garantirFaixa: garantirFaixa,
    estaCompleto: function () { return completo; },
    voltar: function () { location.href = VOLTAR; },
    janela: function (cfg) { abrirJanela(cfg); },
    fecharJanela: function () { fecharJanela(); },
    preservadas: function () { return Object.keys(preservadas()); },

    // troca a estrutura inteira: ordem, nome, tipo, filtro e quem pode preencher
    aplicarEstrutura: function (novas, titulo, chave) {
