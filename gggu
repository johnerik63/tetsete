      marcada[cb.getAttribute("data-o")] = cb.checked;
      pintar($("opcBusca").value);
    });
    $("opcBusca").addEventListener("input", function () { pintar(this.value); });
    $("opcTodas").onclick   = function () { todos.forEach(function (o) { marcada[o] = true; });  pintar($("opcBusca").value); };
    $("opcNenhuma").onclick = function () { todos.forEach(function (o) { marcada[o] = false; }); pintar($("opcBusca").value); };
