      // "começa com") era apagado antes de ser aplicado
      var semNada = !valor || (typeof valor === "object"
        && !valor.txt && !valor.eq && !valor.de && !valor.ate && !valor.min && !valor.max);
      if (semNada) delete filtros[nome];
