        b.disabled = true; b.textContent = "Aplicando…";
        tela.mostrar("Aplicando a carga nova", "cruzando por CNPJ + contrato…", { pc:0 });
        aoProgredir = function (feito, total) {
          b.textContent = "Aplicando… " + Math.round(feito / total * 100) + "%";
          tela.pc(feito / total * 100, feito.toLocaleString("pt-BR") + " de "
            + total.toLocaleString("pt-BR") + " linha(s) do arquivo");
        };
        aoSubir = mostrarSubida("Salvando a carga nova");
        tela.depoisDoQuadro().then(function () {
          return aplicarMerge(p, excluir);
        }).then(function(){
          tela.esconder();
          fecharJanela();
          toast(p.atualizadas + " atualizada(s), " + p.novas + " nova(s).");
        }, function (e) {
          tela.esconder(); aoSubir = null;
          toast("Não deu para aplicar: " + (e && e.message ? e.message : "erro"), true);
        });
      }
    }
  }

  /* ---------- carga: cabeçalho primeiro, blocos sob demanda ---------- */

  function registroDoBloco(n){
    for (var k = 0; k < reg.pedacos.length; k++) if (reg.pedacos[k].n === n) return reg.pedacos[k];
    return null;
  }

  // Baixa um bloco (registro n) e encaixa as linhas no lugar certo.
  function baixarBloco(n){
    if (blocoPronto[n]) return Promise.resolve();
    if (pedidos[n]) return pedidos[n];
    var r = registroDoBloco(n);
    if (!r) { blocoPronto[n] = true; return Promise.resolve(); }
    var etagLido = "";
    pedidos[n] = chamar("/annotations(" + r.id + ")?$select=documentbody").then(function (resp) {
      var b = (resp && resp.documentbody) || "";
      etagLido = (resp && resp["@odata.etag"]) || "";
      if (b && !ehCifrado(b)) blocoClaro[n] = true; else delete blocoClaro[n];
      if (COMPACTA && magicaDe(b) === "LCP1") blocoVelho[n] = true; else delete blocoVelho[n];
      return abrirCorpo(b);
    }).then(function (txt) {
      r.marca = impressao(txt);
      if (etagLido) r.etag = etagLido;
      var bl = JSON.parse(txt);
      txt = null;
      var arr = (bl && bl.linhas) || [];
      var base = (n - 1) * (doc.porBloco || POR_BLOCO);
      for (var j = 0; j < arr.length; j++) doc.linhas[base + j] = arr[j];
      converterParaNomes(base, base + arr.length);
      blocoPronto[n] = true;
      prontos++;
      delete pedidos[n];
      pintarCarga();
    }).catch(function (e) {
      delete pedidos[n];
      throw e;
    });
    return pedidos[n];
  }

  // Quais blocos cobrem as linhas de de..ate
  function blocosDaFaixa(de, ate){
    var por = doc.porBloco || POR_BLOCO, lista = [];
    var primeiro = Math.floor(de / por), ultimo = Math.floor(Math.max(de, ate - 1) / por);
    for (var i = primeiro; i <= ultimo && i < qtdBlocos; i++) lista.push(i + 1);
    return lista;
  }

  function garantirFaixa(de, ate){
    if (completo) return Promise.resolve();
    var faltam = blocosDaFaixa(de, ate).filter(function (n) { return !blocoPronto[n]; });
    if (!faltam.length) return Promise.resolve();
    return emLotes(faltam.map(function (n) { return function () { return baixarBloco(n); }; }), 4)
      .then(function () { recarregarMemoria(); });
  }

  // Continua puxando o resto sem travar a tela.
  function carregarFundo(){
    if (completo) return;
    var faltam = [];
    for (var i = 1; i <= qtdBlocos; i++) if (!blocoPronto[i]) faltam.push(i);
    if (!faltam.length) { terminouCarga(); return; }
    emLotes(faltam.map(function (n) {
      return function () { return baixarBloco(n).catch(function () {}); };
    }), 3).then(function () {
      var resta = false;
      for (var i = 1; i <= qtdBlocos; i++) if (!blocoPronto[i]) resta = true;
      if (resta) setTimeout(carregarFundo, 400);
      else terminouCarga();
    });
  }

  function terminouCarga(){
    completo = true;
    prontos = qtdBlocos;
    pintarCarga();
    recarregarMemoria();
    // todo mundo que pediu a carteira inteira (antes só o último era avisado e
    // quem pediu antes ficava esperando para sempre)
    var fila = esperandoTudo; esperandoTudo = [];
    fila.forEach(function (f) { try { f(); } catch (e) { console.warn(e); } });
    protegerAoAbrir();
  }

  /* ---------- proteção obrigatória, em todas as listas ----------
     - lista que já foi protegida e alguém gravou sem cifra (aba antiga, versão velha
       do web resource, carga por fora): quem abrir com a chave cifra de novo, sozinho
     - lista que nunca foi protegida: protege assim que quem cuida dela (senha do
       quadrado laranja) abrir — e mostra o link do time para mandar para o pessoal
     - não existe mais "tirar a proteção" */
  function faltaProteger(){ return !cifrada || Object.keys(blocoClaro).length > 0; }
  // Blocos cifrados por versões anteriores ficaram sem compactar (~3 MB cada, no teste
  // real a lista inteira tinha 60 MB para baixar). Quem cuida da lista, ao abrir,
  // regrava esses blocos compactados — uma vez só, em segundo plano.
  function compactarSeFaltar(){
    if (!cifrada || !COMPACTA || !completo || protegendo) return false;
    var ns = Object.keys(blocoVelho);
    if (!ns.length) return false;
    ns.forEach(function (n) { sujarLinha((+n - 1) * (doc.porBloco || POR_BLOCO)); });
    agendarGravacao();
    return true;
  }
  function protegerAoAbrir(){
    if (!faltaProteger() || protegendo) { if (modoAdmin()) compactarSeFaltar(); return; }
    var jaTinha = chave ? chaveTxt : chaveGuardada();
    if (jaTinha) { protegerAgora(jaTinha, false); return; }
    if (modoAdmin()) {
      protegerAgora(null, true).then(function (novo) {
        if (novo && planilha.mostrarLinkDoTime) planilha.mostrarLinkDoTime();
      });
      return;
    }
    aviso("Esta lista ainda não está protegida. Quem cuida dela precisa abrir o quadrado laranja uma vez para proteger.");
  }
  // devolve true se foi a primeira proteção desta lista (tem link novo para mandar)
  function protegerAgora(txt, primeira){
    if (!faltaProteger()) return Promise.resolve(false);
    protegendo = true;
    var t = txt || paraB64url(crypto.getRandomValues(new Uint8Array(32)));
    return (chave && chaveTxt === t ? Promise.resolve(chave) : importarChave(t)).then(function (k) {
      chave = k; chaveTxt = t; guardarChave(t); chaveNoEndereco(t);
      var tudo = !cifrada;                     // cabeçalho sem cifra: regrava a lista inteira
      cifrada = true;
      trocandoCripto = true;
      if (tudo) {
        reg.pedacos.forEach(function (p) { p.marca = null; });
        sujarTudo();
      } else {
        Object.keys(blocoClaro).forEach(function (n) {    // só os blocos que ficaram sem cifra
          var r = registroDoBloco(+n); if (r) r.marca = null;
          sujarLinha((+n - 1) * (doc.porBloco || POR_BLOCO));
        });
      }
      blocoClaro = {};
      clearTimeout(tGravar);
      if (primeira) tela.mostrar("Protegendo a lista", "", { pc:0 });
      return esperarGravacao().then(function () {
        if (primeira) aoSubir = mostrarSubida("Protegendo a lista");
        return gravar();
      });
    }).then(function () {
      trocandoCripto = false; protegendo = false;
      if (primeira) tela.esconder();
      if (cifrada) aviso("");
      return !!primeira;
    }, function (e) {
      trocandoCripto = false; protegendo = false;
      if (primeira) tela.esconder();
      toast("Não deu para proteger a lista: " + (e && e.message || "erro"), true);
      return false;
    });
  }

  function pintarCarga(){
    var el = $("statusCarga");
    if (!el) return;
    if (completo || !qtdBlocos) { el.innerHTML = ""; return; }
    var pc = Math.round(prontos / qtdBlocos * 100);
    el.innerHTML = '<span class="chip b">carregando o resto · ' + pc + "%</span>";
  }

  // Para filtrar, ordenar, exportar ou colar, a carteira inteira precisa estar aqui.
  function garantirTudo(){
    if (completo) return Promise.resolve();
    return new Promise(function (ok) {
      function andou(){
        tela.pc(prontos / Math.max(1, qtdBlocos) * 100,
                "baixando a carteira inteira · bloco " + prontos + " de " + qtdBlocos);
      }
      if (!esperandoTudo.length) {
        tela.mostrar("Terminando de carregar a carteira", "", { pc:0 });
        andou(); tela.seguir(andou, 250);
      }
      esperandoTudo.push(function () { tela.esconder(); ok(); });
      carregarFundo();
    });
  }

  function carregar(silencioso){
    if (!SLUG) {
      tela.erro("Nenhuma lista no endereço", "Volte e escolha uma.",
                { rotulo:"Todas as listas", acao:function () { location.href = VOLTAR; } });
      return Promise.resolve();
    }
    // recarregando por baixo de alguém: tira o cursor da célula antes (senão ela
    // continuaria apontando para a linha antiga depois que as linhas andarem)
    if (silencioso && celulaEmFoco()) document.activeElement.blur();
    tela.mostrar(silencioso ? "Atualizando a lista" : "Abrindo a lista",
                 "procurando a lista no Dataverse…", { cheia: !silencioso });
    blocoPronto = {}; prontos = 0; completo = false; qtdBlocos = 0; pedidos = {}; blocoClaro = {}; blocoVelho = {};

    return acharRegistros().then(function (achados) {
      if (!achados.length) throw new Error("não achei a lista “" + SLUG + "”.");
      reg.prefixo = achados[0].prefixo;
      reg.pedacos = achados;
      tela.pc(null, "baixando o cabeçalho…");
      var r0 = registroDoBloco(0);
      return chamar("/annotations(" + r0.id + ")?$select=documentbody").then(function (resp) {
        var b = (resp && resp.documentbody) || "";
        cifrada = ehCifrado(b);
        if (cifrada) tela.pc(null, "abrindo a lista protegida…");
        return abrirCorpo(b).then(function (txt) { return { b:b, txt:txt, etag: resp && resp["@odata.etag"] }; });
      }).then(function (lido) {
        var cab = null;
        try { cab = JSON.parse(lido.txt); } catch (e) {}
        if (cab && cab.formato === "blocos") {           // formato novo: dá para ir por partes
          r0.marca = impressao(lido.txt);
          if (lido.etag) r0.etag = lido.etag;
          totalServidor = cab.total || 0;
          doc = cab;
          doc.colunas = doc.colunas || [];
          doc.linhas = new Array(cab.total || 0);
          qtdBlocos = cab.blocos || 0;
          blocoPronto[0] = true;
          todosSujos = false;
          return true;
        }
        cifrada = false;
        return baixarTudo(achados).then(function (obj) {   // formato antigo: vem tudo de uma vez
          doc = obj;
          doc.colunas = doc.colunas || [];
          doc.linhas  = doc.linhas  || [];
          converterParaNomes();
          completo = true;
          return false;
        });
      });
    }).then(function (porPartes) {
      indexar();
      document.title = doc.titulo || SLUG;
      $("titulo").textContent = doc.titulo || SLUG;
      $("tagEstado").textContent = "salvo";
      carimbo();
      var alvo = porPartes ? blocosDaFaixa(0, POR_PAGINA) : [];
      if (alvo.length) {
        var andou = function () {
          var f = alvo.filter(function (n) { return blocoPronto[n]; }).length;
          tela.pc(f / alvo.length * 100, "baixando a primeira página · bloco " + f + " de " + alvo.length);
        };
        andou(); tela.seguir(andou, 150);
      }
      var primeiro = porPartes ? garantirFaixa(0, POR_PAGINA) : Promise.resolve();
      return primeiro.then(function () {
        tela.pc(null, "desenhando a tabela…");
        recarregarMemoria();
        tela.esconder();
        if (!doc.colunas.length) {
          aviso("Esta lista ainda está vazia — clique em “Colar lista nova” para trazer os dados.");
          janelaColar();
        } else aviso("");
        marcarVisto(); vigiar(); ligarSincronizacao();
        if (porPartes) { pintarCarga(); setTimeout(carregarFundo, 250); }
        else protegerAoAbrir();
      });
    }).catch(function (e) {
      if (e && e.codigo === "SEM_CHAVE")
        return telaPedirLink("Esta lista é protegida",
          "Abra pelo link do time uma vez neste navegador — ele já traz a chave. Depois abre direto.");
      if (e && e.codigo === "CHAVE_ERRADA")
        return telaPedirLink("A chave deste navegador não abre esta lista",
          "Pode ser que a lista tenha ganhado uma chave nova. Abra pelo link do time mais recente.");
      tela.erro("Não deu para abrir a lista", e.message
        + " — confira se você está logado no Dynamics nesta mesma aba.");
    });
  }

  // Sem chave: em vez de travar, deixa colar o link do time ali mesmo.
  function telaPedirLink(tit, msg){
    tela.erro(tit, msg, { rotulo:"Abrir", acao:function () {
      var v = String(($("capaLink") || {}).value || "").trim();
      var m = v.match(/[#&?]k=([A-Za-z0-9_-]{40,})/);
      var k = m ? m[1] : (/^[A-Za-z0-9_-]{40,}$/.test(v) ? v : "");
      if (!k) { $("capaLink").focus(); $("capaSub").textContent = "Isso não parece o link do time. Cole o link inteiro."; return; }
      guardarChave(k);
      location.hash = "k=" + k;
      location.reload();
    } });
    $("capaErro").insertAdjacentHTML("afterbegin",
      '<input id="capaLink" type="text" placeholder="Cole aqui o link do time" autocomplete="off" '
      + 'style="width:100%;border:1px solid #C6D2E2;border-radius:8px;padding:8px 10px;font:inherit;'
      + 'font-size:13px;margin:0 0 10px">');
    var c = $("capaLink");
    if (c) { c.focus(); c.addEventListener("keydown", function (ev) { if (ev.key === "Enter") $("capaBt").click(); }); }
  }

  /* ---------- botões do topo ---------- */
  $("fundo").onclick = function(){ fecharJanela(); };
  document.addEventListener("keydown", function(e){ if (e.key === "Escape") fecharJanela(); });
  window.addEventListener("beforeunload", function(e){
    if (planilha.pendente()) { e.preventDefault(); e.returnValue = ""; }
  });

  carregar();
})();
</script>

<script>

