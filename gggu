    // trabalho pesado na carteira inteira: a tela só aparece se demorar
    function pesado(tit, sub, fn){
      if (typeof sub === "function") { fn = sub; sub = ""; }
      mostrar(tit, sub, { atrasada:true });
      return depoisDoQuadro().then(fn).then(
        function (r) { esconder(); return r; },
        function (e) { esconder(); throw e; });
    }
