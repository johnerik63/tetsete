        if (velho && velho !== c.nome) renomearChave(velho, c.nome);
      });
      novas.forEach(function (c) {
        if (c.tipo === "opcao" && (!c.opcoes || !c.opcoes.length)) {
          var vistos = {};
          doc.linhas.forEach(function (l) { var v = l[c.nome]; if (!vazio(v)) vistos[v] = 1; });
          c.opcoes = Object.keys(vistos).sort().slice(0, 300);
