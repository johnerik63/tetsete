  // Dado mudou por causa de outra pessoa (juntei no salvamento ou puxei na
  // sincronização): refaz filtro e ordem, mas a tela fica na mesma página e na
  // mesma rolagem. Antes voltava para o topo toda vez que alguém mexia no seu bloco.
  var ouvintesSuaves = [];
  function recarregarSuave(){
    planilha.linhas = doc.linhas || [];
    planilha.filtradas = aplicarFiltros(planilha.linhas);
    if (!ouvintesSuaves.length) { planilha.avisarMudanca(); return; }
    ouvintesSuaves.forEach(function (fn) { try { fn(); } catch (e) { console.warn(e); } });
    var fora = planilha.linhas.filter(function(l){ return l && l.__fora; }).length;
    $("statusFora").innerHTML = fora
      ? '<span class="chip d">' + fora + " fora da carga atual</span>" : "";
