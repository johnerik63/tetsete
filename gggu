  /* ---------- ler ---------- */
  function filtroDosRegistros(){
    var ors = PREFIXOS.map(function(p){ return "startswith(subject,'" + p + SLUG + "')"; });
    return encodeURIComponent("(" + ors.join(" or ") + ")");
  }
  function acharRegistros(){
    var url = "/annotations?$select=annotationid,subject,notetext,modifiedon"
            + "&$filter=" + filtroDosRegistros() + "&$top=200";
    return chamar(url).then(function(j){
      var todos = (j && j.value) || [], achados = [];
      todos.forEach(function(r){
        PREFIXOS.forEach(function(pre){
          var base = pre + SLUG;
          var s = String(r.subject || "");
          if (s !== base && s.indexOf(base + "#") !== 0) return;
          var n = s === base ? 0 : (parseInt(s.slice(base.length + 1), 10) || 0);
          achados.push({ id:r.annotationid, n:n, prefixo:pre, modificado:r.modifiedon,
                         etag: r["@odata.etag"] || "" });
        });
      });
      // o mesmo apelido em dois prefixos não pode misturar os pedaços: vale o
      // primeiro prefixo da lista PREFIXOS que tiver registro
      for (var q = 0; q < PREFIXOS.length; q++) {
        var desse = achados.filter(function (a) { return a.prefixo === PREFIXOS[q]; });
        if (desse.length) { achados = desse; break; }
