  // Formato novo: o registro 0 é o cabeçalho e cada registro seguinte é um bloco
  // de POR_BLOCO linhas — assim, mexer numa célula só reescreve um bloco.
  // Formato antigo: os pedaços eram fatias de base64 e só valem colados.
  function montarDoc(b64, achados){
    try {
      var cab = JSON.parse(deB64(b64[0]));
      if (cab && cab.formato === "blocos") {
        var linhas = [];
        for (var i = 1; i < b64.length; i++) {
          var bl = JSON.parse(deB64(b64[i]));
          var arr = (bl && bl.linhas) || [];
          for (var j = 0; j < arr.length; j++) linhas.push(arr[j]);
          if (achados[i]) achados[i].marca = impressao(deB64(b64[i]));
          b64[i] = null;
        }
        cab.linhas = linhas;
        todosSujos = false;             // o que está lá já bate com o que temos
        return cab;
      }
    } catch (e) {}
    todosSujos = true;                  // arquivo no formato antigo: a próxima gravação refaz tudo
    return JSON.parse(deB64(b64.join("")));
  }

  function indexar(){
    _mapCol = null; _grupos = null;
    porNome = {};
    (doc.colunas || []).forEach(function(c){ porNome[String(c.nome).toLowerCase()] = c.id; });
  }

  // No arquivo as linhas são {c1:…, c2:…}. Na memória elas viram {cliente:…, cnpj:…}
  // UMA VEZ SÓ — com 300 mil linhas, manter duas cópias estoura o navegador.
  function converterParaNomes(de, ate){
    var cols = doc.colunas || [], linhas = doc.linhas || [];
    de = de || 0; ate = ate == null ? linhas.length : ate;
    for (var i = de; i < ate; i++) {
      var l = linhas[i];
      if (!l) continue;
      var o = { __i:i };
      if (l.__fora) o.__fora = true;
      for (var j = 0; j < cols.length; j++) {
        var v = l[cols[j].id];
        if (v !== undefined && v !== null && v !== "") o[cols[j].nome] = v;
      }
      linhas[i] = o;
    }
  }
  // e volta para {c1:…} na hora de gravar
  function paraIds(de, ate){
    var cols = doc.colunas || [], linhas = doc.linhas || [];
    de = de || 0; ate = ate == null ? linhas.length : ate;
    var saida = new Array(Math.max(0, ate - de));
    for (var i = de; i < ate; i++) {
      var l = linhas[i] || {}, o = {};
      for (var j = 0; j < cols.length; j++) {
        var v = l[cols[j].nome];
        if (v !== undefined && v !== null && v !== "") o[cols[j].id] = v;
      }
