  function pedirSenha(){
    var conferindo = false;
    function conferir(){
      if (conferindo) return;
      var v = ($("admSenha").value || "").trim();
      if (!v) { $("admSenha").focus(); return; }
      conferindo = true;
      $("admSenhaErro").textContent = "conferindo…";
      hashDaSenha(v).then(function (h) {
        conferindo = false;
        if (h !== SENHA_HASH) {
          $("admSenhaErro").innerHTML = '<span style="color:var(--ruim)">Senha errada.</span>';
          $("admSenha").value = "";
          $("admSenha").focus();
          return;
        }
        try { sessionStorage.setItem(CHAVE_SENHA, "1"); } catch (e) {}
        planilha.fecharJanela();
        entrarAdm();
      }, function () {
        conferindo = false;
        $("admSenhaErro").innerHTML = '<span style="color:var(--ruim)">Este navegador não conseguiu conferir a senha.</span>';
      });
    }
    planilha.janela({
      titulo: "Configurar a lista",
      sub: "Área de quem cuida da estrutura.",
      miolo: '<label for="admSenha">Senha</label>'
           + '<input type="password" id="admSenha" autocomplete="off" placeholder="senha">'
           + '<div class="conta" id="admSenhaErro"></div>',
      botoes: [
        { rotulo:"Cancelar", fecha:true },
        { rotulo:"Entrar", classe:"pri", acao:conferir }
      ]
    });
    var c = $("admSenha");
    if (c) {
      c.focus();
      c.addEventListener("keydown", function (e) {
        if (e.key === "Enter") { e.preventDefault(); conferir(); }
      });
    }
  }
  // quem cuida da lista entrou: se ela ainda não está protegida, protege agora
  // (é obrigatório) e mostra o link do time para mandar para o pessoal
  function entrarAdm(){
    planilha.protegerSeFaltar().then(function (primeira) {
      abrirAdm();
      if (primeira) janelaCripto();
    }, function () { abrirAdm(); });
  }
  function chamarAdm(){
    planilha.garantirTudo().then(function () {
      if (liberado()) entrarAdm(); else pedirSenha();
    });
  }

  $("selo").addEventListener("click", chamarAdm);
  $("selo").addEventListener("keydown", function (e) {
    if (e.key === "Enter" || e.key === " ") { e.preventDefault(); chamarAdm(); }
  });
  $("admFecha").onclick   = fecharAdm;
  $("admCancela").onclick = fecharAdm;
  $("admSalva").onclick   = function () { salvarAdm(this); };
  $("admColar").onclick   = function () { fecharAdm(); planilha.colar(); };
  $("admExcel").onclick   = function () { planilha.baixar(); };
  $("admVoltar").onclick  = function () { planilha.voltar(); };
  $("admCripto").onclick  = janelaCripto;
  planilha.mostrarLinkDoTime = janelaCripto;     // a parte 1 chama depois da 1ª proteção

  function janelaCripto(){
    var ligada = planilha.estaCifrada(), link = planilha.linkDoTime();
    if (ligada) {
      planilha.janela({
        titulo: "Proteção dos dados",
        sub: "Obrigatória em todas as listas · cifrada no Dataverse (AES-256).",
        miolo: '<div class="nota" style="margin:0 0 12px">Quem abre pelo <b>link do time</b> — ou num navegador '
             + "que já abriu por ele — vê a lista normal, sem senha. Nas Anotações, na API, no Advanced Find e em "
             + "qualquer exportação do Dataverse ela aparece embaralhada.</div>"
             + (link
                ? '<label for="cripLink">Link do time (já leva a chave)</label>'
                  + '<div style="display:flex;gap:6px"><input id="cripLink" readonly value="' + esc(link) + '" '
                  + 'style="flex:1;min-width:0;border:1px solid #C6D2E2;border-radius:8px;padding:7px 9px;'
                  + 'font:12px ui-monospace,Consolas,monospace;background:#FAFBFD">'
                  + '<button type="button" id="cripCopia">Copiar</button></div>'
                : "")
             + '<div class="nota" style="background:#FFF7EE;border-color:#F6C793;color:#8A4B00">'
             + "<b style=\"color:#8A4B00\">Guarde esse link num lugar seguro.</b> A chave só existe nele e nos "
             + "navegadores que já abriram a lista. Se sumir de todos, os dados não voltam — ninguém consegue "
             + "recuperar, nem o administrador do Dataverse. E quem tiver o link consegue ver a lista.</div>",
        botoes: [
          { vaga:true },
          { rotulo:"Fechar", classe:"pri", fecha:true }
        ]
      });
      var cp = $("cripCopia");
      if (cp) cp.onclick = function () {
        var i = $("cripLink"); i.focus(); i.select();
        var ok = function () { toast("Link do time copiado."); };
        if (navigator.clipboard && navigator.clipboard.writeText)
          navigator.clipboard.writeText(i.value).then(ok, function () { try { document.execCommand("copy"); ok(); } catch (e) {} });
        else { try { document.execCommand("copy"); ok(); } catch (e) {} }
      };
      return;
    }
    planilha.janela({
      titulo: "Esta lista ainda não está protegida",
      sub: "A proteção é obrigatória — ela deveria ter ligado sozinha ao entrar aqui.",
      miolo: '<div class="nota" style="margin:0">Algo impediu a proteção automática (rede ou permissão). '
           + "Tente de novo — a lista é gravada cifrada e o link do time aparece em seguida.</div>",
      botoes: [
        { rotulo:"Fechar", fecha:true },
        { rotulo:"Proteger agora", classe:"pri", acao:function (b) {
            b.disabled = true;
            planilha.fecharJanela();
            planilha.protegerSeFaltar().then(function () {
              if (planilha.estaCifrada()) { toast("Lista protegida. Copie o link do time."); janelaCripto(); }
            });
          } }
      ]
    });
  }
  document.addEventListener("keydown", function (e) {
    if (e.key !== "Escape") return;
    if (!$("jan").classList.contains("on")) fecharAdm();
  });

  // Dado mudou por causa de outra pessoa: mesma página, mesma rolagem e sem
  // roubar o cursor de quem está digitando (aí espera sair da célula).
  var redesenhoAdiado = false;
  function redesenharSuave(){
    var a = document.activeElement;
    if (a && a.hasAttribute && a.hasAttribute("data-celula")) { redesenhoAdiado = true; pintarStatus(); return; }
    redesenhoAdiado = false;
    var pg = pagina, st = $("env").scrollTop, n = desenhadas;
    cacheOpcoes = {};
    carregarDados();                         // refaz filtro e ordem (e volta a página para 0)
    pagina = pg;
    desenhar();                              // desenhar() ajusta a página se ela deixou de existir
    while (desenhadas < Math.min(n, fatia.length)) desenhar(true);
    $("env").scrollTop = st;
  }
  if (planilha.aoSincronizar) planilha.aoSincronizar(redesenharSuave);
  document.addEventListener("focusout", function (ev) {
    if (!redesenhoAdiado || !ev.target || !ev.target.hasAttribute || !ev.target.hasAttribute("data-celula")) return;
    setTimeout(function () { if (redesenhoAdiado) redesenharSuave(); }, 80);
  });

  lerPref();
  planilha.aoMudar(function(){
    cacheOpcoes = {};                    // os dados mudaram: as opções do filtro também
    var a = document.activeElement;
    if (a && a.hasAttribute && a.hasAttribute("data-celula")) { pintarStatus(); return; }
    montarColunas();
    if (medidoCom !== planilha.linhas.length) medirColunas();
    montarCabecalho();
    carregarDados();
    desenhar();
  });
})();
</script>
</body>
</html>