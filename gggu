  /* ---------- C) sincronização: ver o que o time salvou, sem clicar em Atualizar ----------
     A cada 45 s (e quando a aba volta a ficar visível), pergunta ao Dataverse só a
     "versão" de cada bloco. O que mudou é baixado e entra na tela sem mexer na
     página nem na rolagem. Não roda enquanto você tem edição por salvar; com o
     cursor parado numa célula, a tela só se redesenha quando você sai dela.
     Mudou a estrutura (carga nova, coluna, linha excluída): recarrega a lista. */
  var SINC_MS = 45000, tSinc = null, sincronizando = false;
  function celulaEmFoco(){
    var a = document.activeElement;
    return !!(a && a.hasAttribute && a.hasAttribute("data-celula"));
  }
  function podeSincronizar(){
    if (!doc || !completo || gravando || tGravar || tRetry || recarregando || protegendo) return false;
    if (temSujeira() || document.hidden) return false;
    if ($("jan").classList.contains("on")) return false;
    var adm = $("adm"); if (adm && adm.classList.contains("on")) return false;
    if (!$("capa").classList.contains("off")) return false;
    return true;
  }
  function sincronizar(){
    if (sincronizando || !podeSincronizar()) return Promise.resolve();
    sincronizando = true;
    function fim(){ sincronizando = false; }
    return acharRegistros().then(function (achados) {
      if (!podeSincronizar()) return;
      var estrutura = achados.length !== reg.pedacos.length, mudaram = [];
      achados.forEach(function (a) {
        var meu = registroDoBloco(a.n);
        if (!meu || meu.id !== a.id) { estrutura = true; return; }
        // versão do registro: etag quando o Dataverse manda, senão a data de alteração
        var sabe = (a.etag && meu.etag) || (a.modificado && meu.modificado);
        if (!sabe && a.n === 0 && meu.meu) {                // cabeçalho que eu mesmo gravei
          meu.etag = a.etag; meu.modificado = a.modificado; return;
        }
        var igual = a.etag && meu.etag ? a.etag === meu.etag
                  : (a.modificado && meu.modificado ? a.modificado === meu.modificado : false);
        if (igual) return;
        if (a.n === 0) estrutura = true; else mudaram.push(a);
      });
      if (estrutura) {
        if (celulaEmFoco()) document.activeElement.blur();
        return carregar(true);
      }
      var mudouAlgo = false, fila = Promise.resolve(), estruturaDepois = false;
      mudaram.forEach(function (a) {
        fila = fila.then(function () {
          if (estruturaDepois || !podeSincronizar()) return;
          return chamar("/annotations(" + a.id + ")?$select=documentbody").then(function (resp) {
            var etag = (resp && resp["@odata.etag"]) || a.etag;
            return abrirCorpo((resp && resp.documentbody) || "").then(function (txt) {
              var meu = registroDoBloco(a.n);
              if (!meu) return;
              var marca = impressao(txt);
              if (marca === meu.marca) { meu.etag = etag; meu.modificado = a.modificado; return; }   // é o que eu mesmo gravei
              // alguém começou a editar enquanto baixava: não troca nada, tenta na próxima
              if (temSujeira() || gravando) return;
              var bl = JSON.parse(txt), arr = (bl && bl.linhas) || [];
              var base = (a.n - 1) * (doc.porBloco || POR_BLOCO);
              var ids = idsDaChave(), andou = false;
              for (var j = 0; j < arr.length && !andou; j++) {
                var l = doc.linhas[base + j];
                var km = l ? chaveDe(l) : null, ks = chaveDosIds(arr[j] || {}, ids);
                if (km && ks && km !== ks) andou = true;
              }
              if (andou) { estruturaDepois = true; return; }
              trazerParaMemoria(arr, base);
              meu.marca = marca; meu.etag = etag; meu.modificado = a.modificado;
              mudouAlgo = true;
            });
          });
        });
      });
      return fila.then(function () {
        if (estruturaDepois && podeSincronizar()) return carregar(true);
        if (mudouAlgo) recarregarSuave();
      });
    }).then(fim, fim);
  }
  function ligarSincronizacao(){
