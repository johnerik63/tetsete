  };
  window.planilha = planilha;
  planilha.tela = tela;
  function estruturaAgora(novas, titulo, chave){ return planilha._estrutura(novas, titulo, chave); }
  planilha.chaveAtual = function () { return chaveAtual(); };
  planilha.chaveEscolhida = function () { return chaveEscolhida(); };
  // as colunas que a chave padrão (CNPJ + contrato) usaria nesta lista
  planilha.chavePadrao = function () {
    return [CHAVE_CNPJ, CHAVE_CONTRATO].map(function (g) {
      for (var i = 0; i < g.length; i++) { var c = colPorNome(g[i]); if (c) return c.nome; }
      return null;
    }).filter(Boolean);
  };

  /* ---------- filtros ---------- */
  function num(v){
    if (v == null || v === "") return null;
    var s = String(v).trim().replace(/\s|R\$/g, "");
    if (s.indexOf(",") >= 0 && s.indexOf(".") >= 0) {
      s = s.lastIndexOf(",") > s.lastIndexOf(".")
        ? s.replace(/\./g, "").replace(",", ".") : s.replace(/,/g, "");
    } else if (s.indexOf(",") >= 0) s = s.replace(",", ".");
    else if (/^-?\d{1,3}(\.\d{3})+$/.test(s)) s = s.replace(/\./g, "");
    var n = parseFloat(s);
    return isNaN(n) ? null : n;
  }
  function texto(v){
    return String(v == null ? "" : v).toLowerCase()
      .normalize("NFD").replace(/[\u0300-\u036f]/g, "");
  }
  // Busca feita só de números e pontuação ("03.492.384/1301-77", "03492384",
  // "1301-77", "03 492 384"): devolve as formas só com dígitos para procurar também.
  // Vai com e sem o zero da frente, porque o Excel costuma comer o zero do CNPJ.
  function formasDigitos(q){
    q = String(q == null ? "" : q).trim();
    if (!/^[\d\s.\-\/]+$/.test(q)) return null;
    var d = q.replace(/\D/g, "");
    // menos de 6 dígitos não é documento: "31-60" é a faixa, não um pedaço de CNPJ
    if (d.length < 6) return null;
    var formas = [d], semZero = d.replace(/^0+/, "");
    if (d.length >= 11 && semZero.length >= 8 && semZero !== d) formas.push(semZero);
    return formas;
  }
  // o mesmo teste do filtro de texto da coluna, só que comparando dígito com dígito
  function bateDigitos(v, formas, modo){
    var dv = String(v == null ? "" : v).replace(/\D/g, "");
    if (!dv) return false;
    var dz = dv.replace(/^0+/, "");
    for (var i = 0; i < formas.length; i++) {
      var q = formas[i], qz = q.replace(/^0+/, "");
      if (modo === "igual") { if (dz === qz) return true; }
      else if (modo === "comeca") { if (dv.indexOf(q) === 0 || (qz && dz.indexOf(qz) === 0)) return true; }
      else if (dv.indexOf(q) >= 0) return true;
    }
    return false;
  }

  function aplicarFiltros(linhas){
    var chaves = Object.keys(filtros);
    if (!chaves.length) return linhas.slice();
    var nomesCols = (doc && doc.colunas ? doc.colunas : []).map(function (c) { return c.nome; });
    var alvoBusca = texto(filtros.busca || "");
    var formasBusca = formasDigitos(filtros.busca);
    var formasCol = {};                 // idem para o "contém / igual / começa com" de cada coluna
    chaves.forEach(function (k) {
      var f = filtros[k];
      if (k !== "busca" && f && typeof f === "object" && f.txt) formasCol[k] = formasDigitos(f.txt);
    });
    return linhas.filter(function (l) {
      if (!l) return false;
      for (var i = 0; i < chaves.length; i++) {
        var k = chaves[i], f = filtros[k];
        if (k === "busca") {
          // o texto de busca da linha é montado uma vez e fica guardado nela
          var alvo = l.__b;
          if (alvo === undefined) {
            // junto do texto vai a versão só com dígitos de cada campo, para achar
            // CNPJ e contrato digitados sem ponto, barra ou traço
            var pedacos = [], digitos = [];
            for (var c = 0; c < nomesCols.length; c++) {
              var vv = l[nomesCols[c]];
              if (vv == null || vv === "") continue;
              pedacos.push(vv);
              var d = String(vv).replace(/[^0-9]+/g, "");
              if (d.length >= 4 && d !== String(vv)) digitos.push(d);
            }
            alvo = l.__b = texto(pedacos.join(" "))
                 + (digitos.length ? " " + digitos.join(" ") : "");
          }
          if (alvo.indexOf(alvoBusca) < 0) {
            // não achou como foi digitado: tenta só os dígitos (CNPJ com ou sem ponto)
            var achou = false;
            if (formasBusca) for (var fb = 0; fb < formasBusca.length && !achou; fb++)
              achou = alvo.indexOf(formasBusca[fb]) >= 0;
            if (!achou) return false;
          }
          continue;
        }
        var v = l[k];
        if (typeof f === "string") {
          if (texto(v).indexOf(texto(f)) < 0) return false;
        } else if (f && typeof f === "object") {
          if (f.eq != null && f.eq !== "") {
            if (f.num) { if (num(v) !== num(f.eq)) return false; }
            else if (String(v == null ? "" : v).trim() !== String(f.eq).trim()) return false;
          }
          if (f.txt != null && f.txt !== "") {
            var a = texto(v), b = texto(f.txt), ok;
            if (f.modo === "igual")       ok = a === b;
            else if (f.modo === "comeca") ok = a.indexOf(b) === 0;
            else                          ok = a.indexOf(b) >= 0;
            if (!ok && formasCol[k]) ok = bateDigitos(v, formasCol[k], f.modo);
            if (!ok) return false;
          }
          if (f.de  != null && f.de  !== "" && String(v || "") <  String(f.de))  return false;
          if (f.ate != null && f.ate !== "" && String(v || "") >  String(f.ate)) return false;
          if (f.min != null && f.min !== "" && !(num(v) >= num(f.min))) return false;
          if (f.max != null && f.max !== "" && !(num(v) <= num(f.max))) return false;
        }
      }
      return true;
    });
  }

