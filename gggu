    var precisa = Math.ceil(ctx.measureText(String(txt == null ? "" : txt)).width) + 34;
    var n = String(nome).toLowerCase();
    var atual = larguras[n] || medidas[n] || larguraDe(c);
    if (precisa <= atual) return;
    larguras[n] = Math.min(600, precisa);   // digitando, a coluna pode passar do teto normal
