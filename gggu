  /* =======================================================================
     colar lista nova — cruza por CNPJ + contrato e preserva o preenchido
     ======================================================================= */
  /* ---------- ler arquivo do computador: csv, txt e xlsx ---------- */

  // O .xlsx é um zip. O navegador já sabe descompactar, então não precisa de biblioteca.
  function lerZip(buf){
    var dv = new DataView(buf), u8 = new Uint8Array(buf);
    var fim = -1, limite = Math.max(0, u8.length - 65558);
    for (var i = u8.length - 22; i >= limite; i--) {
      if (dv.getUint32(i, true) === 0x06054b50) { fim = i; break; }
    }
    if (fim < 0) throw new Error("esse arquivo não parece um .xlsx");
    var quantos = dv.getUint16(fim + 10, true), p = dv.getUint32(fim + 16, true);
    var arquivos = {};
    for (var k = 0; k < quantos; k++) {
      if (dv.getUint32(p, true) !== 0x02014b50) break;
      var metodo   = dv.getUint16(p + 10, true);
      var tamComp  = dv.getUint32(p + 20, true);
      var lenNome  = dv.getUint16(p + 28, true);
      var lenExtra = dv.getUint16(p + 30, true);
      var lenCom   = dv.getUint16(p + 32, true);
      var offLocal = dv.getUint32(p + 42, true);
      var nome = new TextDecoder().decode(u8.subarray(p + 46, p + 46 + lenNome));
      var lnNome  = dv.getUint16(offLocal + 26, true);
      var lnExtra = dv.getUint16(offLocal + 28, true);
      var ini = offLocal + 30 + lnNome + lnExtra;
      arquivos[nome] = { metodo:metodo, dados: u8.subarray(ini, ini + tamComp) };
      p += 46 + lenNome + lenExtra + lenCom;
    }
    return arquivos;
  }

  function textoDoZip(entrada){
    if (!entrada) return Promise.resolve("");
    if (entrada.metodo === 0) return Promise.resolve(new TextDecoder().decode(entrada.dados));
    if (typeof DecompressionStream !== "function")
      return Promise.reject(new Error("este navegador não abre .xlsx aqui — salve como CSV"));
    var fluxo = new Blob([entrada.dados]).stream()
      .pipeThrough(new DecompressionStream("deflate-raw"));
    return new Response(fluxo).text();
  }

  function desescapar(s){
    if (s.indexOf("&") < 0) return s;
    return s.replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, '"')
            .replace(/&apos;/g, "'")
            .replace(/&#x([0-9a-fA-F]+);/g, function (_, h) { return String.fromCharCode(parseInt(h, 16)); })
            .replace(/&#(\d+);/g, function (_, d) { return String.fromCharCode(+d); })
            .replace(/&amp;/g, "&");
  }

  function textosCompartilhados(xml){
    var out = [], p = 0;
    while (true) {
      var a = xml.indexOf("<si", p); if (a < 0) break;
      var f = xml.indexOf("</si>", a);
      var trecho = f < 0 ? xml.slice(a) : xml.slice(a, f);
      p = f < 0 ? xml.length : f + 5;
      var texto = "", re = /<t[^>]*>([\s\S]*?)<\/t>/g, m;
      while ((m = re.exec(trecho))) texto += m[1];
      out.push(desescapar(texto));
    }
    return out;
  }

  // Descobre quais estilos são de data (senão a data vira um número solto).
  function detectorDeData(xml){
    var proprios = {}, m;
    var re = /<numFmt[^>]*numFmtId="(\d+)"[^>]*formatCode="([^"]*)"/g;
    while ((m = re.exec(xml || ""))) proprios[m[1]] = desescapar(m[2]);
    var estilos = [];
    var bloco = (xml || "").match(/<cellXfs[\s\S]*?<\/cellXfs>/);
    if (bloco) {
      var re2 = /<xf[^>]*numFmtId="(\d+)"/g, m2;
      while ((m2 = re2.exec(bloco[0]))) estilos.push(m2[1]);
    }
    return function (s) {
      var id = estilos[+s || 0];
      if (id == null) return false;
      var n = +id;
      if ((n >= 14 && n <= 22) || (n >= 27 && n <= 36) || (n >= 45 && n <= 47) || (n >= 50 && n <= 58)) return true;
      var f = proprios[id];
      if (!f) return false;
      f = f.replace(/\[[^\]]*\]/g, "").replace(/"[^"]*"/g, "");
      return /[dmyhs]/i.test(f);
    };
  }

  function dataDeSerial(n){
    var ms = Math.round((n - 25569) * 86400000);
    var d = new Date(ms);
    if (isNaN(d)) return String(n);
    var z = function (x) { return (x < 10 ? "0" : "") + x; };
    return z(d.getUTCDate()) + "/" + z(d.getUTCMonth() + 1) + "/" + d.getUTCFullYear();
  }

  function colunaDaRef(ref){
    var n = 0;
    for (var i = 0; i < ref.length; i++) {
      var c = ref.charCodeAt(i);
      if (c < 65 || c > 90) break;
      n = n * 26 + (c - 64);
    }
    return n - 1;
  }

  function lerAba(xml, textos, ehData){
    var linhas = [], p = 0;
    while (true) {
      var a = xml.indexOf("<row", p); if (a < 0) break;
      var fecha = xml.indexOf(">", a); if (fecha < 0) break;
      var sozinha = xml.charAt(fecha - 1) === "/";
      var corpo = "", fim;
      if (sozinha) { fim = fecha + 1; }
      else {
        var b = xml.indexOf("</row>", fecha);
        if (b < 0) break;
        corpo = xml.slice(fecha + 1, b);
        fim = b + 6;
      }
      p = fim;
      linhas.push(lerCelulas(corpo, textos, ehData));
    }
    return linhas;
  }

  function lerCelulas(trecho, textos, ehData){
    var celulas = [], q = 0, maior = -1;
    while (true) {
      var a = trecho.indexOf("<c", q); if (a < 0) break;
      var seguinte = trecho.charAt(a + 2);
      if (seguinte !== " " && seguinte !== ">" && seguinte !== "/") { q = a + 2; continue; }
      var fecha = trecho.indexOf(">", a); if (fecha < 0) break;
      var atributos = trecho.slice(a + 2, fecha);
      var sozinha = trecho.charAt(fecha - 1) === "/";
      var corpo = "", fim;
      if (sozinha) { fim = fecha + 1; }
      else {
        var b = trecho.indexOf("</c>", fecha);
        if (b < 0) break;
        corpo = trecho.slice(fecha + 1, b);
        fim = b + 4;
      }
      q = fim;
      var mr = atributos.match(/r="([A-Z]+)/);
      var mt = atributos.match(/t="([^"]*)"/);
      var ms = atributos.match(/s="(\d+)"/);
      var col = mr ? colunaDaRef(mr[1]) : (maior + 1);
      if (col > maior) maior = col;
      var tipo = mt ? mt[1] : "";
      var valor = "";
      if (tipo === "inlineStr") {
        var re = /<t[^>]*>([\s\S]*?)<\/t>/g, m;
        while ((m = re.exec(corpo))) valor += m[1];
        valor = desescapar(valor);
      } else {
        var mv = corpo.match(/<v[^>]*>([\s\S]*?)<\/v>/);
        var bruto = mv ? mv[1] : "";
        if (tipo === "s") valor = textos[+bruto] || "";
        else if (tipo === "b") valor = bruto === "1" ? "Sim" : "Não";
        else if (tipo === "e") valor = "";
        else if (tipo === "str") valor = desescapar(bruto);
        else if (bruto !== "" && ehData(ms ? ms[1] : 0) && !isNaN(+bruto)) valor = dataDeSerial(+bruto);
        else valor = desescapar(bruto);
      }
      celulas[col] = valor;
    }
    for (var i = 0; i < celulas.length; i++) if (celulas[i] === undefined) celulas[i] = "";
    return celulas;
  }

  function lerExcel(buf){
    var zip = lerZip(buf);
    return textoDoZip(zip["xl/workbook.xml"]).then(function (wb) {
      var alvoAba = "xl/worksheets/sheet1.xml", nomeAba = "";
      var mSheet = wb.match(/<sheet[^>]*\/>/);
      if (mSheet) {
        var mn = mSheet[0].match(/name="([^"]*)"/);
        nomeAba = mn ? desescapar(mn[1]) : "";
      }
      return textoDoZip(zip["xl/_rels/workbook.xml.rels"]).then(function (rels) {
        var rid = mSheet && mSheet[0].match(/r:id="([^"]*)"/);
        if (rid) {
          var re = new RegExp('Id="' + rid[1] + '"[^>]*Target="([^"]*)"');
          var mt = (rels || "").match(re);
          if (!mt) {
            re = new RegExp('Target="([^"]*)"[^>]*Id="' + rid[1] + '"');
            mt = (rels || "").match(re);
          }
          if (mt) {
            var alvo2 = mt[1].replace(/^\/?xl\//, "").replace(/^\//, "");
            if (zip["xl/" + alvo2]) alvoAba = "xl/" + alvo2;
          }
        }
        if (!zip[alvoAba]) {
          for (var k in zip) if (k.indexOf("xl/worksheets/") === 0) { alvoAba = k; break; }
        }
        return Promise.all([
          textoDoZip(zip["xl/sharedStrings.xml"]),
          textoDoZip(zip["xl/styles.xml"]),
          textoDoZip(zip[alvoAba])
        ]).then(function (partes) {
          var textos = textosCompartilhados(partes[0] || "");
          var ehData = detectorDeData(partes[1] || "");
          var tabela = lerAba(partes[2] || "", textos, ehData);
          return { tabela: tabela, aba: nomeAba };
        });
      });
    });
  }

  // CSV/TXT: tenta UTF-8 e, se o arquivo for do Excel em ANSI, cai para windows-1252
  function textoDoArquivo(buf){
    try {
      return new TextDecoder("utf-8", { fatal:true }).decode(buf);
    } catch (e) {
      try { return new TextDecoder("windows-1252").decode(buf); }
      catch (e2) { return new TextDecoder().decode(buf); }
    }
  }

  function lerArquivo(arq){
    var nome = String(arq.name || "").toLowerCase();
    return arq.arrayBuffer().then(function (buf) {
      if (/\.xlsx$|\.xlsm$/.test(nome)) {
        return lerExcel(buf).then(function (r) {
          var t = r.tabela.filter(function (l) { return l && l.join("").trim() !== ""; });
          if (!t.length) throw new Error("a planilha veio vazia");
          return { cab: t.shift().map(normNome), linhas: t, aba: r.aba };
        });
      }
      if (/\.xls$/.test(nome))
        throw new Error(".xls antigo não dá — abra no Excel e salve como .xlsx ou CSV");
      var d = parsear(textoDoArquivo(buf));
      if (!d || !d.linhas.length) throw new Error("não achei linhas nesse arquivo");
      return d;
    });
  }

  function parsear(txt){
    var linhas = String(txt || "").replace(/\r\n?/g, "\n").split("\n");
    while (linhas.length && !linhas[linhas.length - 1].trim()) linhas.pop();
    if (!linhas.length) return null;
    var sep = linhas[0].indexOf("\t") >= 0 ? "\t" : (linhas[0].indexOf(";") >= 0 ? ";" : ",");
    var tabela = linhas.map(function (L) { return L.split(sep).map(function (c) {
      c = c.trim();
      if (c.charAt(0) === '"' && c.charAt(c.length-1) === '"') c = c.slice(1,-1).replace(/""/g,'"');
      return c;
    }); });
    var cab = tabela.shift().map(normNome);
    return { cab:cab, linhas: tabela.filter(function(r){ return r.join("").trim() !== ""; }) };
  }

  function comoData(v){
    var s = String(v || "").trim();
    var m = s.match(/^(\d{2})[\/\-](\d{2})[\/\-](\d{4})$/);
    if (m) return m[3] + "-" + m[2] + "-" + m[1];
    if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
    return null;
  }
  function tipoDe(nome, valores){
    var vs = valores.filter(function(v){ return !vazio(v); }).slice(0, 300);
    if (!vs.length) return { tipo:"texto" };
    var datas = 0, nums = 0;
    vs.forEach(function(v){ if (comoData(v)) datas++; if (num(v) != null) nums++; });
    if (datas / vs.length > 0.8) return { tipo:"data" };
    if (nums / vs.length > 0.9)  return { tipo:"numero" };
    var dist = {}; vs.forEach(function(v){ dist[v] = 1; });
    var ops = Object.keys(dist);
    if (ops.length <= 40) return { tipo:"opcao", opcoes: ops.sort() };
    return { tipo:"texto" };
  }
  function filtroPadrao(tipo){
    if (tipo === "numero") return "busca";
    if (tipo === "data")   return "intervalo";
    if (tipo === "opcao")  return "lista";
    return "contem";
  }

  // O que a colagem nova não pode atropelar. PADRÃO FIXO: só as colunas de
  // preencher (+ o que estiver em PRESERVAR_EXTRA). A janela de colar sempre abre
  // assim; o que for mudado nela vale só para aquela carga e não fica guardado.
  // (Uma escolha antiga guardada na coluna, c.protegida, é ignorada.)
  function protegidaPadrao(c){
    var n = String(c.nome).toLowerCase();
    return !!c.editavel || PRESERVAR_EXTRA.indexOf(n) >= 0;
  }
  function estaProtegida(c){ return protegidaPadrao(c); }
  function preservadas(){
    var m = {}, tem = {};
    ((doc && doc.colunas) || []).forEach(function(c){
      var n = String(c.nome).toLowerCase();
      tem[n] = true;
      if (estaProtegida(c)) m[n] = true;
    });
    // nomes da configuração que ainda não viraram coluna continuam valendo
    PRESERVAR_EXTRA.forEach(function(n){
      n = String(n).toLowerCase();
      if (!tem[n]) m[n] = true;
    });
    return m;
  }
  // O que foi marcado na janela de colar vale para o salvamento DAQUELA carga
  // (inclusive na hora de juntar com o que o time gravou no servidor).
  var guardaDaCarga = null;

  function valorDe(l, nomes){
    for (var i = 0; i < nomes.length; i++) if (!vazio(l[nomes[i]])) return l[nomes[i]];
    return "";
  }

  /* ---------- a chave do cruzamento ----------
     As colunas que dizem "é a mesma linha" entre uma carga e outra (e entre o que
     cada pessoa grava). Escolhidas no quadrado laranja, coluna "Chave", e guardadas
     na lista (doc.chave). Sem escolha, vale o de sempre: CNPJ + contrato. */
  var _grupos = null;
  function gruposDaChave(){
    if (_grupos) return _grupos;
    var g = [];
    if (doc && doc.chave && doc.chave.length)
      g = doc.chave.filter(function (n) { return !!colPorNome(n); })
                   .map(function (n) { return [colPorNome(n).nome]; });
    if (!g.length) g = [CHAVE_CNPJ, CHAVE_CONTRATO];
    return (_grupos = g);
  }
  function chaveEscolhida(){ return gruposDaChave()[0] !== CHAVE_CNPJ; }
  // nomes das colunas que estão valendo como chave agora (para mostrar)
  function chaveAtual(){
    return gruposDaChave().map(function (g) {
      for (var i = 0; i < g.length; i++) { var c = colPorNome(g[i]); if (c) return c.nome; }
      return null;
    }).filter(Boolean);
  }
  // mudou a chave: as chaves guardadas nas linhas não valem mais
  function esquecerChaves(){
    _grupos = null;
    var ls = (doc && doc.linhas) || [];
    for (var i = 0; i < ls.length; i++) if (ls[i] && ls[i].__k !== undefined) delete ls[i].__k;
  }

  // A chave fica guardada na própria linha: antes ela era recalculada (com regex)
  // três vezes por carga, para cada linha da carteira.
  function chaveDe(l){
    if (l.__k !== undefined) return l.__k;
    var gs = gruposDaChave(), partes = [], algum = false;
    for (var i = 0; i < gs.length; i++) {
      var v = so(valorDe(l, gs[i]));
      if (v) algum = true;
      partes.push(v);
    }
    return (l.__k = algum ? partes.join("|") : null);
  }

  // A mesma chave, lida direto da linha do arquivo (sem montar um objeto por linha).
  function chaveDoArquivo(cab){
    var cabMin = cab.map(function (n) { return String(n).toLowerCase(); });
    var grupos = gruposDaChave().map(function (g) {
      var ids = [];
      for (var i = 0; i < g.length; i++) {
        var p = cabMin.indexOf(String(g[i]).toLowerCase());
        if (p >= 0) ids.push(p);
      }
      return ids;
    });
    return function (r) {
      var partes = [], algum = false;
      for (var q = 0; q < grupos.length; q++) {
        var v = "";
        for (var i = 0; i < grupos[q].length; i++) if (!vazio(r[grupos[q][i]])) { v = r[grupos[q][i]]; break; }
        v = so(v);
        if (v) algum = true;
        partes.push(v);
      }
      return algum ? partes.join("|") : null;
    };
  }
  // colunas da chave que o arquivo não trouxe
  function chaveFaltandoNoArquivo(cab){
    var cabMin = cab.map(function (n) { return String(n).toLowerCase(); });
    var gs = gruposDaChave(), falta = [];
    gs.forEach(function (g, q) {
      var tem = g.some(function (n) { return cabMin.indexOf(String(n).toLowerCase()) >= 0; });
      // chave padrão: o contrato pode faltar (cruza só pelo CNPJ); escolhida: todas precisam vir
      if (!tem && (chaveEscolhida() || q === 0)) falta.push(g[0]);
    });
    return falta;
  }

  // monta as colunas a partir do cabeçalho colado (mantendo as que já existem)
  function ajustarColunas(cab, tabela){
    doc.colunas = doc.colunas || [];
    var existe = {};
    doc.colunas.forEach(function(c){ existe[String(c.nome).toLowerCase()] = c; });
    var maior = 0;
    doc.colunas.forEach(function(c){ var n = parseInt(String(c.id).slice(1),10)||0; if (n>maior) maior=n; });
    cab.forEach(function(nome, j){
      // mesma amostra de antes (300 primeiros não vazios), sem materializar a coluna inteira
      var valores = [];
      for (var q = 0; q < tabela.length && valores.length < 300; q++) {
        var vq = tabela[q] ? tabela[q][j] : null;
        if (!vazio(vq)) valores.push(vq);
      }
      var t = tipoDe(nome, valores);
      var c = existe[nome];
      if (c) {
        if (t.opcoes && c.tipo === "opcao") {           // acrescenta valores novos à lista
          var vistos = {}; (c.opcoes||[]).forEach(function(o){ vistos[o]=1; });
          t.opcoes.forEach(function(o){ if(!vistos[o]) c.opcoes.push(o); });
          c.opcoes.sort();
        }
        return;
      }
      maior++;
      estruturaMudou = true;
      doc.colunas.push({
        id: "c" + maior, nome: nome, tipo: t.tipo, opcoes: t.opcoes || null,
        filtro: t.tipo === "opcao" || ["cliente","produto","faixa","gera","dt_carga",
                 "faixa_fechamento","evitar_pdd","atraso_dias","proxima_parcela"].indexOf(nome) >= 0,
        filtroTipo: filtroPadrao(t.tipo),
        editavel: EDITAVEIS.indexOf(nome) >= 0,
        origem: "import"
      });
    });
    indexar();
  }

  function simularMerge(dados, escolha){
    var cab = dados.cab, tabela = dados.linhas;
    var atuais = doc.linhas || [];
    var porChave = Object.create(null), i;
    for (i = 0; i < atuais.length; i++) {
      var kA = chaveDe(atuais[i]);
      if (kA) porChave[kA] = atuais[i];
    }

    var novas = 0, atualizadas = 0, semChave = 0, guardadas = 0, repetidas = 0;
    var vistos = Object.create(null);
    var guarda = Object.keys(escolha || preservadas());
    var chaveArq = chaveDoArquivo(cab);
    for (i = 0; i < tabela.length; i++) {
      var k = chaveArq(tabela[i]);
      if (!k) { semChave++; continue; }
      if (vistos[k]) { repetidas++; continue; }
      vistos[k] = 1;
      var alvo = porChave[k];
      if (alvo) {
        atualizadas++;
        for (var g = 0; g < guarda.length; g++) if (!vazio(alvo[guarda[g]])) guardadas++;
      } else novas++;
    }
    var saem = 0;
    for (i = 0; i < atuais.length; i++) {
      var kS = chaveDe(atuais[i]);
      if (kS && !vistos[kS]) saem++;
    }
    return { novas:novas, atualizadas:atualizadas, saem:saem, semChave:semChave, repetidas:repetidas,
             guardadas:guardadas, cab:cab, tabela:tabela, vistos:vistos,
             guarda: escolha || null };
  }

  function aplicarMerge(p, excluirQueSaem){
    ajustarColunas(p.cab, p.tabela);
    guardaDaCarga = p.guarda || null;             // a escolha da janela vale para esta carga
    var linhas = doc.linhas || [];
    var posPorChave = Object.create(null), i;
    for (i = 0; i < linhas.length; i++) {
      var kI = chaveDe(linhas[i]);
      if (kI) posPorChave[kI] = i;
    }

    // resolve coluna, "é data" e "é preservada" UMA vez por coluna do arquivo,
    // em vez de uma vez por célula
    var preserva = p.guarda || preservadas();      // o que foi marcado na janela desta carga
    var nCol = p.cab.length, nomes = [], ehData = [], guardaCol = [];
    for (i = 0; i < nCol; i++) {
      var cI = colPorNome(p.cab[i]);
      nomes[i]     = cI ? cI.nome : null;
      ehData[i]    = !!(cI && cI.tipo === "data");
      guardaCol[i] = !!preserva[p.cab[i]];
    }
    var chaveArq = chaveDoArquivo(p.cab);
    var antes = linhas.length, tocadas = [];

    return emFatias(p.tabela.length, 4000, function (ini, fim) {
      for (var t = ini; t < fim; t++) {
        var r = p.tabela[t], j, nm, vv;
        var k = chaveArq(r);
        if (k == null) continue;              // sem chave: não dá para cruzar — fica de fora (como a prévia avisa)
        var pos = posPorChave[k];

        if (pos === undefined) {
          var nova = {};
          for (j = 0; j < nCol; j++) {
            nm = nomes[j]; if (nm === null) continue;
            vv = r[j];
            if (vv === undefined || vv === null || vv === "") continue;
            if (ehData[j]) vv = comoData(vv) || vv;
            nova[nm] = vv;
          }
          if (k != null) { nova.__k = k; posPorChave[k] = linhas.length; }
          linhas.push(nova);
          continue;
        }

        var alvo = linhas[pos];
        alvo.__fora = false;
        if (alvo.__b !== undefined) delete alvo.__b;
        for (j = 0; j < nCol; j++) {
          nm = nomes[j]; if (nm === null) continue;
          vv = r[j];
          if (ehData[j]) vv = comoData(vv) || vv;
          if (guardaCol[j]) {
            if (vazio(alvo[nm]) && !vazio(vv)) alvo[nm] = vv;   // só preenche buraco
            continue;
          }
          if (vv === undefined || vv === null || vv === "") delete alvo[nm];
          else alvo[nm] = vv;
        }
        alvo.__k = k;
        tocadas.push(pos);
      }
    }, aoProgredir).then(function () {

      // quem não veio na carga nova
      var fora = [], q;
      for (q = 0; q < linhas.length; q++) {
        var kF = chaveDe(linhas[q]);
        if (kF && !p.vistos[kF]) fora.push(q);
      }

      if (excluirQueSaem) {
        for (q = fora.length - 1; q >= 0; q--) linhas.splice(fora[q], 1);
        sujarTudo();                         // os índices andaram: reescreve tudo
      } else {
        for (q = 0; q < fora.length; q++) {
          if (linhas[fora[q]].__fora !== true) { linhas[fora[q]].__fora = true; tocadas.push(fora[q]); }
        }
        if (GRAVAR_SO_MUDADO) {
          for (q = 0; q < tocadas.length; q++) sujarLinhaMassa(tocadas[q]);
          if (antes > 0) sujarLinhaMassa(antes - 1);       // o último bloco pode ter crescido
          for (q = antes; q < linhas.length; q++) sujarLinhaMassa(q);
        } else sujarTudo();
      }

      renumerar();
      recarregarMemoria();
      aoProgredir = null;
      return gravar();
    });
  }

  var _mapCol = null, _mapColRef = null, _mapColN = -1;
  function mapaColunas(){
    var cs = doc.colunas || [];
    if (_mapCol && _mapColRef === cs && _mapColN === cs.length) return _mapCol;
    var m = Object.create(null);
    for (var i = 0; i < cs.length; i++) m[String(cs[i].nome).toLowerCase()] = cs[i];
    _mapCol = m; _mapColRef = cs; _mapColN = cs.length;
    return m;
