  // reenumera __i depois de acrescentar ou tirar linha
  function renumerar(){
    var linhas = doc.linhas || [];
    for (var i = 0; i < linhas.length; i++) if (linhas[i]) linhas[i].__i = i;
  }

  /* ---------- gravar ---------- */

  function corpoDoRegistro(n, b64, nota){
    return { subject: reg.prefixo + SLUG + (n ? "#" + n : ""),
             filename: SLUG + (n ? "-" + n : "") + ".json",
             mimetype: "application/json", documentbody: b64, notetext: nota };
  }

  // Lê o que está no servidor AGORA, junto com o ETag daquele registro.
  function lerRegistro(n){
    var r = registroDoBloco(n);
    if (!r) return Promise.resolve(null);
    return chamar("/annotations(" + r.id + ")?$select=documentbody").then(function (resp) {
      var b = (resp && resp.documentbody) || "", ci = ehCifrado(b);
      return abrirCorpo(b).then(function (txt) {
        var obj = null;
        try { obj = JSON.parse(txt); } catch (e) {}
        return { obj: obj, etag: resp && resp["@odata.etag"], cifrado: ci, marca: impressao(txt),
                 formato: magicaDe(b) === "LCP1" || magicaDe(b) === "LCP2" ? magicaDe(b) : (b ? "texto" : "") };
      });
    });
  }

  // Grava um registro. Com etag, o Dataverse recusa (412) se alguém tiver
  // gravado entre a minha leitura e a minha escrita.
  // recebe o TEXTO: a marca é tirada dele (cifrado, o mesmo conteúdo sai diferente a
  // cada vez) e a cifra, se a lista for protegida, acontece aqui
  function subirRegistro(n, txt, nota, etag){
    var existente = registroDoBloco(n);
    var marca = impressao(txt);
    if (existente && existente.marca === marca && n > 0) return Promise.resolve();
    var corpo, op, caminho = existente ? "/annotations(" + existente.id + ")" : "/annotations";
    return fecharCorpo(txt).then(function (b64) {
      txt = null;
      corpo = corpoDoRegistro(n, b64, nota);
      op = { method: existente ? "PATCH" : "POST", body: JSON.stringify(corpo) };
      if (existente && etag) op.headers = { "If-Match": etag };
      return chamar(caminho, op);
    }).then(function () {
      corpo.documentbody = null;
      if (existente) { existente.marca = marca; existente.etag = ""; existente.modificado = ""; existente.meu = true; return; }
      return acharRegistros().then(function (a) {
        for (var q = 0; q < a.length; q++) {
          var antigo = null;
          for (var w = 0; w < reg.pedacos.length; w++) if (reg.pedacos[w].n === a[q].n) antigo = reg.pedacos[w];
          if (antigo) a[q].marca = antigo.marca;
          if (a[q].n === n) { a[q].marca = marca; a[q].meu = true; }
        }
        reg.pedacos = a;
      });
    });
  }

  // chave CNPJ+contrato de uma linha do jeito que ela está no arquivo ({c1:…, c2:…})
  function idsDaChave(){
    return gruposDaChave().map(function (g) {
      var ids = [];
      for (var i = 0; i < g.length; i++) { var c = colPorNome(g[i]); if (c) ids.push(c.id); }
      return ids;
    });
  }
  function chaveDosIds(o, grupos){
    var partes = [], algum = false;
    for (var q = 0; q < grupos.length; q++) {
      var v = "";
      for (var i = 0; i < grupos[q].length; i++) if (!vazio(o[grupos[q][i]])) { v = o[grupos[q][i]]; break; }
      v = so(v);
      if (v) algum = true;
      partes.push(v);
    }
    return algum ? partes.join("|") : null;
  }
  function mesmaLinha(a, b){
    var na = 0, k;
    for (k in a) { na++; if (a[k] !== b[k]) return false; }
    for (k in b) na--;
    return na === 0;
  }

  // Junta a minha versão do bloco com a que está no servidor AGORA — casando as
  // linhas pela chave CNPJ + contrato, não pela posição. Pela posição, quando o
  // admin excluía uma linha ou acrescentava no fim, a edição caía na linha do
  // vizinho ou o bloco era regravado por cima e sumia com linha dos outros.
  //   modo célula (só editei células): parto do bloco do servidor inteiro e aplico
  //       só as MINHAS células. Linha minha que não está mais neste bloco vira
  //       "órfã": depois do salvamento a lista é recarregada e ela é reaplicada.
  //   modo massa (carga nova / estrutura / linha nova ou excluída): parto da minha
  //       versão, mas o que o time preencheu nas colunas protegidas continua valendo.
  function juntarBloco(meu, doServidor, base, deMassa, pend, guardaLote){
    pend = pend || {};
    if (!doServidor) return { linhas: meu, mudouLocal: false, orfas: [], deslocou: false };
    var cols = doc.colunas || [], idPorNome = {}, j, k;
    for (j = 0; j < cols.length; j++) idPorNome[cols[j].nome] = cols[j].id;
    var ids = idsDaChave();
    var chS = new Array(doServidor.length), porChave = Object.create(null);
    for (j = 0; j < doServidor.length; j++) {
      var ks = chaveDosIds(doServidor[j] || {}, ids);
      chS[j] = ks;
      if (ks) (porChave[ks] || (porChave[ks] = [])).push(j);
    }
    var chM = new Array(meu.length), deslocou = false;
    for (j = 0; j < meu.length; j++) {
      chM[j] = chaveDosIds(meu[j] || {}, ids);
      if (!deslocou && j < doServidor.length && chM[j] && chS[j] && chM[j] !== chS[j]) deslocou = true;
    }
    function noServidor(j){
      if (chM[j]) {
        var cand = porChave[chM[j]];
        if (!cand) return -1;
        return cand.indexOf(j) >= 0 ? j : cand[0];
      }
      // linha sem CNPJ/contrato: só pela posição, e só se nada andou
      return (!deslocou && doServidor.length === meu.length && !chS[j]) ? j : -1;
    }
    var saida, orfas = [], mudouLocal = false;

    if (deMassa) {
      var guarda = guardaLote || preservadas(), protegidas = [];
      for (j = 0; j < cols.length; j++)
        if (guarda[String(cols[j].nome).toLowerCase()]) protegidas.push(cols[j]);
      saida = meu;
      if (protegidas.length) for (j = 0; j < meu.length; j++) {
        var js = noServidor(j);
        if (js < 0) continue;
        var o = meu[j], p = pend[base + j];
        for (k = 0; k < protegidas.length; k++) {
          var vs = doServidor[js][protegidas[k].id];
          if (vs === undefined || vs === null || vs === "") continue;   // servidor vazio: nada a guardar
          if (p && p[protegidas[k].nome]) continue;                     // eu acabei de mexer nessa célula
          if (o[protegidas[k].id] !== vs) { o[protegidas[k].id] = vs; mudouLocal = true; }
        }
      }
      return { linhas: saida, mudouLocal: mudouLocal, orfas: orfas, deslocou: false };
    }

    saida = new Array(doServidor.length);
    for (j = 0; j < doServidor.length; j++) {
      var c0 = doServidor[j] || {}, cp = {};
      for (k in c0) cp[k] = c0[k];
      saida[j] = cp;
    }
    for (var iStr in pend) {
      var i = +iStr;
      if (i < base || i >= base + meu.length) continue;
      j = i - base;
      var linha = doc.linhas[i] || {}, valores = {}, nome;
      for (nome in pend[iStr]) valores[nome] = linha[nome];
      var alvo = noServidor(j);
      if (alvo < 0) { if (chM[j]) orfas.push({ chave: chM[j], valores: valores }); continue; }
      for (nome in valores) {
        var id = idPorNome[nome];
        if (!id) continue;
        var vm = valores[nome];
        if (vm === undefined || vm === null || vm === "") delete saida[alvo][id];
        else saida[alvo][id] = vm;
      }
    }
    if (saida.length !== meu.length) mudouLocal = true;
    else for (j = 0; j < saida.length && !mudouLocal; j++) if (!mesmaLinha(saida[j], meu[j] || {})) mudouLocal = true;
    return { linhas: saida, mudouLocal: mudouLocal, orfas: orfas, deslocou: deslocou };
  }

  function trazerParaMemoria(bloco, base){
    for (var j = 0; j < bloco.length; j++) doc.linhas[base + j] = bloco[j];
    converterParaNomes(base, base + bloco.length);
  }

  function esperar(ms){ return new Promise(function (ok) { setTimeout(ok, ms); }); }
  // o jeito certo de o registro estar guardado agora
  function formatoIdeal(){ return cifrada ? (COMPACTA ? "LCP2" : "LCP1") : "texto"; }
  // Erro que passa sozinho: alguém gravou antes (412), Dataverse ocupado/limitando
  // (429, 502, 503, 504 — no teste real, duas abas gravando o mesmo bloco deram 503)
  // ou a rede piscou. Tenta de novo ali mesmo, esperando um pouco mais a cada vez.
  function passageiro(e){
    if (!e) return false;
    if (e.status === 412 || e.status === 429 || e.status === 502 || e.status === 503 || e.status === 504) return true;
    return !e.status && !e.codigo && /fetch|network|rede|failed/i.test(String(e.message || e));
  }
  function esperaDoErro(e, tentativas){
    if (e && e.retryAfter) return Math.min(30000, e.retryAfter * 1000);
    var base = e && e.status === 412 ? 150 : 1000;
    return base + Math.random() * (e && e.status === 412 ? 450 : 1500) * tentativas;
  }

  // Sobe um bloco de linhas: lê, junta, grava com ETag e tenta de novo no 412
  // (com uma espera que cresce e varia — com o time todo no mesmo bloco, tentar
  // todo mundo junto de novo só gera outro 412).
  function subirBlocoDeLinhas(idx, v, lote){
    var n = idx + 1, nota = JSON.stringify({ p:n, v:v });
    var base = idx * POR_BLOCO;
    var fimL = Math.min((doc.linhas || []).length, base + POR_BLOCO);
    var deMassa = !!lote.massa[idx];

    if (!registroDoBloco(n))                       // bloco novo: não tem com quem colidir
      return subirRegistro(n, JSON.stringify({ linhas: paraIds(base, fimL) }), nota, null)
        .then(function () { return null; });

    var tentativas = 0;
    function passo(){
      return lerRegistro(n).then(function (serv) {
        var r = registroDoBloco(n);
        // "igual ao servidor agora" = não precisa gravar… a não ser que ele esteja
        // guardado do jeito errado (sem cifra, ou cifrado sem compactar): aí regrava
        if (r && serv) r.marca = serv.formato === formatoIdeal() ? serv.marca : null;
        if (serv && serv.cifrado && !cifrada && chave) cifrada = true;   // alguém protegeu: cifro também
        var meu = paraIds(base, fimL);
        var junto = juntarBloco(meu, serv && serv.obj && serv.obj.linhas, base, deMassa, lote.pend, lote.guarda);
        return subirRegistro(n, JSON.stringify({ linhas: junto.linhas }), nota, serv && serv.etag)
          .then(function () {
            if (junto.mudouLocal && !junto.deslocou) { trazerParaMemoria(junto.linhas, base); mudouDoServidor = true; }
            delete blocoVelho[n]; delete blocoClaro[n];
            return junto;
          });
      }).catch(function (e) {
        if (passageiro(e) && tentativas < 8) { tentativas++; return esperar(esperaDoErro(e, tentativas)).then(passo); }
        throw e;
      });
    }
    return passo();
  }

  /* ---------- avisar quando alguém gravar ---------- */
  function maisNovoNoServidor(){
    return chamar("/annotations?$select=modifiedon&$filter=" + filtroDosRegistros()
                + "&$orderby=modifiedon desc&$top=1").then(function (j) {
      var v = j && j.value && j.value[0];
      return v ? String(v.modifiedon) : "";
    });
  }
  function pintarNovidade(tem){
    var el = $("statusNovo");
    if (!el) return;
    el.innerHTML = tem
      ? '<span class="chip b" id="chipNovo" style="cursor:pointer" '
        + 'title="Alguém gravou depois que você abriu">há uma versão mais nova · atualizar</span>'
      : "";
    var c = $("chipNovo");
    if (c) c.onclick = function () { var b = $("btAtualizar"); if (b) b.click(); };
  }
  function marcarVisto(){
    if (!AVISAR_CONFLITO) return Promise.resolve();   // aviso desligado: não pergunta ao servidor
    return maisNovoNoServidor().then(function (m) {
      modificadoVisto = m; pintarNovidade(false);
    }).catch(function () {});
  }
  function vigiar(){
    clearInterval(tVigia);
    if (!AVISAR_CONFLITO) return;          // sem aviso, não precisa ficar perguntando ao servidor
    tVigia = setInterval(function () {
      if (gravando || document.hidden) return;
      maisNovoNoServidor().then(function (m) {
        if (m && modificadoVisto && m > modificadoVisto) pintarNovidade(true);
      }).catch(function () {});
    }, 30000);
  }

  // Alguém renomeou/acrescentou coluna enquanto eu estava com a lista aberta:
  // adoto a lista de colunas do servidor e levo as minhas linhas junto (a chave
  // de cada linha é o NOME da coluna, então renomear exige remapear).
  function adotarColunasDoServidor(servCols){
    if (!servCols || !servCols.length) return false;
    var meuPorId = {}, mudou = false;
    (doc.colunas || []).forEach(function (c) { meuPorId[c.id] = c.nome; });
    servCols.forEach(function (c) {
      var velho = meuPorId[c.id];
      if (velho && velho !== c.nome) { renomearChave(velho, c.nome); mudou = true; }
      if (!velho) mudou = true;
    });
    if ((doc.colunas || []).length !== servCols.length) mudou = true;
    doc.colunas = servCols;
    indexar();
    return mudou;
  }

  // O cabeçalho guarda colunas, título e contagem. Mesma proteção dos blocos:
  // lê, decide quem manda, grava com ETag e refaz no 412.
  function subirCabecalho(cabecalho, nota, lote){
    var tentativas = 0, minhaEstrutura = !!(lote && lote.estrutura);
    function passo(){
      return lerRegistro(0).then(function (serv) {
        var cab = cabecalho;
        if (serv && !trocandoCripto && serv.cifrado && !cifrada) {
          // alguém protegeu a lista enquanto eu estava com ela aberta: passo a cifrar também
          if (!chave) throw erroCodigo("SEM_CHAVE",
            "a lista foi protegida enquanto você mexia — abra de novo pelo link do time");
          cifrada = true;
          reg.pedacos.forEach(function (p) { if (p.n > 0) p.marca = null; });
        }
        // servidor sem cifra e eu cifrada: alguém gravou com versão velha — este
        // cabeçalho sobe cifrado por cima (proteção é obrigatória, não desliga)
        var servCols = serv && serv.obj && serv.obj.colunas;
        var difere = servCols && JSON.stringify(servCols) !== JSON.stringify(doc.colunas);
        if (difere && !minhaEstrutura) {
          // não fui eu que mexi: quem manda na estrutura é o servidor
          if (adotarColunasDoServidor(servCols)) mudouDoServidor = true;
          cab = Object.assign({}, cabecalho, {
            colunas: doc.colunas,
            titulo: serv.obj.titulo || cabecalho.titulo
          });
          if (serv.obj.pagina) cab.pagina = serv.obj.pagina;
          if (JSON.stringify(serv.obj.chave || null) !== JSON.stringify(doc.chave || null)) {
            doc.chave = serv.obj.chave || null; esquecerChaves();
          }
          if (doc.chave) cab.chave = doc.chave; else delete cab.chave;
          doc.titulo = cab.titulo;
        } else if (difere && minhaEstrutura && AVISAR_CONFLITO) {
          toast("Outra pessoa também mexeu nas colunas — prevaleceu a sua alteração.", true);
        }
        return subirRegistro(0, JSON.stringify(cab), nota, serv && serv.etag);
      }).catch(function (e) {
        if (passageiro(e) && tentativas < 8) { tentativas++; return esperar(esperaDoErro(e, tentativas)).then(passo); }
        throw e;
      });
    }
    return passo();
  }

  function temSujeira(){
    return todosSujos || estruturaMudou || Object.keys(sujosBlocos).length > 0
        || Object.keys(blocosMassa).length > 0;
  }
  // devolve para a fila o que um salvamento que falhou tinha levado
  function devolver(lote){
    var k, c;
    for (k in lote.sujos) sujosBlocos[k] = true;
    for (k in lote.massa) blocosMassa[k] = true;
    for (k in lote.pend) {
      if (!pendentes[k]) pendentes[k] = {};
      for (c in lote.pend[k]) pendentes[k][c] = true;
    }
    if (lote.tudo) todosSujos = true;
    if (lote.estrutura) estruturaMudou = true;
    if (lote.guarda && !guardaDaCarga) guardaDaCarga = lote.guarda;
  }

  // Sobe só os blocos que mudaram — e o cabeçalho só quando precisa (estrutura,
  // carga nova, linha nova/excluída). Antes o cabeçalho subia em TODA edição de
  // célula: com o time todo editando, era o registro mais disputado da lista.
  function gravar(){
    // já tem um salvamento andando: este entra na fila, sem tela (quem pediu já
    // fecha a sua ao receber a resposta — não pode sobrar tela aberta depois)
    if (gravando || recarregando) { sujo = true; aoSubir = null; return Promise.resolve(); }
    clearTimeout(tGravar); tGravar = null;
    clearTimeout(tRetry); tRetry = null;
    // Pega o que está sujo AGORA e zera. O que for editado enquanto este envio está
    // no ar vai para o próximo — antes era apagado junto no fim e se perdia.
    var lote = { sujos: sujosBlocos, massa: blocosMassa, pend: pendentes,
                 tudo: todosSujos, estrutura: estruturaMudou, guarda: guardaDaCarga };
    guardaDaCarga = null;
    sujosBlocos = {}; blocosMassa = {}; pendentes = {}; todosSujos = false; estruturaMudou = false;
    gravando = true; sujo = false;
    $("tagEstado").textContent = "salvando…";

    var linhas = doc.linhas || [];
    var qtd = Math.max(1, Math.ceil(linhas.length / POR_BLOCO));
    var v = versao();
    var precisaCab = lote.tudo || lote.estrutura || trocandoCripto
                  || Object.keys(lote.massa).length > 0 || linhas.length !== totalServidor;
    if (precisaCab) doc.atualizadoEm = agora();

    var cabecalho = {
      formato: "blocos", porBloco: POR_BLOCO, blocos: qtd, total: linhas.length,
      versao: doc.versao || 1, criada: doc.criada || agora(), titulo: doc.titulo || SLUG,
      colunas: doc.colunas || [], atualizadoEm: doc.atualizadoEm
    };
    if (doc.chave && doc.chave.length) cabecalho.chave = doc.chave;
    if (doc.pagina) cabecalho.pagina = doc.pagina;

    var nota = JSON.stringify({ t:doc.titulo || SLUG, nc:(doc.colunas || []).length,
                                nl:linhas.length, p:qtd + 1,
                                h:doc.pagina ? 1 : 0, v:v, c:cifrada ? 1 : 0 });

    mudouDoServidor = false;
    var totalPassos = precisaCab ? 1 : 0, feitos = 0, avisar = aoSubir;
    var orfas = [], deslocou = false;
    function andou(){ feitos++; if (avisar) try { avisar(feitos, totalPassos); } catch (e) {} }
    var fila = precisaCab ? subirCabecalho(cabecalho, nota, lote).then(andou) : Promise.resolve();

    var enfileirar = function (idx) {
      totalPassos++;
      fila = fila.then(function () { return subirBlocoDeLinhas(idx, v, lote); }).then(function (j) {
        if (j && j.orfas && j.orfas.length) orfas = orfas.concat(j.orfas);
        if (j && j.deslocou) deslocou = true;
        andou();
      });
    };
    for (var i = 0; i < qtd; i++) {
      if (!lote.tudo && !lote.sujos[i]) continue;             // esse bloco não mudou
      if (!completo && !blocoPronto[i + 1]) continue;         // nem foi baixado: não mexe nele
      enfileirar(i);
    }

    // registros que sobraram (a lista encolheu) — só quando a estrutura é minha
    if (precisaCab) reg.pedacos.forEach(function (p) {
      if (p.n > qtd) fila = fila.then(function () {
        return chamar("/annotations(" + p.id + ")", { method:"DELETE" });
      });
    });
    if (avisar) try { avisar(0, totalPassos); } catch (e) {}

    return fila.then(function () {
      aoSubir = null;
      gravando = false;
      falhasSeguidas = 0;
      if (precisaCab) totalServidor = linhas.length;
      $("tagEstado").textContent = temSujeira() ? "editando…" : "salvo";
      if (precisaCab) carimbo();
      marcarVisto();
      if (orfas.length || deslocou) {
        // linhas andaram no servidor (alguém excluiu/acrescentou): recarrega e
        // reaplica pela chave o que era meu
        mudouDoServidor = false;
        recarregarReaplicando(orfas);
      } else if (mudouDoServidor) {
        mudouDoServidor = false;
        recarregarSuave();                    // a tela já fica com as duas versões
        if (AVISAR_CONFLITO)
          toast("Outra pessoa editou enquanto você mexia — a tela já está com as duas versões.");
      }
      if (sujo) agendarGravacao();
    }).catch(function (e) {
      aoSubir = null;
      gravando = false;
      devolver(lote);                         // nada do que estava pendente se perde
      if (e && e.codigo === "SEM_CHAVE") {
        $("tagEstado").textContent = "erro ao salvar";
        toast("A lista foi protegida enquanto você mexia. Abra de novo pelo link do time — "
            + "a última edição não foi salva.", true);
        return;
      }
      // rede, sessão, 412 insistente: tenta de novo sozinho, cada vez esperando mais
      falhasSeguidas++;
      var espera = Math.min(60000, 3000 * Math.pow(2, falhasSeguidas - 1));
      $("tagEstado").textContent = "não salvou · tentando de novo";
      if (falhasSeguidas === 1)
        toast("Não deu para salvar agora (" + (e && e.message || "erro") + "). Vou tentar de novo "
            + "sozinho — não feche a aba.", true);
      tRetry = setTimeout(gravar, espera);
    });
  }

  // Linhas andaram no servidor enquanto eu editava: recarrega a lista e reaplica,
  // pela chave CNPJ + contrato, o que era meu e ainda não tinha lugar certo.
  function recarregarReaplicando(orfas){
    var lista = (orfas || []).slice();
    Object.keys(pendentes).forEach(function (iStr) {        // o que eu editei depois também vai junto
      var l = doc.linhas[+iStr]; if (!l) return;
      var k = chaveDe(l); if (!k) return;
      var vals = {}; for (var nome in pendentes[iStr]) vals[nome] = l[nome];
      lista.push({ chave: k, valores: vals });
    });
    pendentes = {}; sujosBlocos = {}; clearTimeout(tGravar); tGravar = null;
    recarregando = true;
    return carregar(true).then(function () { return garantirTudo(); }).then(function () {
      recarregando = false;
      if (!lista.length) return;
      var pos = Object.create(null);
      for (var i = 0; i < doc.linhas.length; i++) {
        var k = doc.linhas[i] && chaveDe(doc.linhas[i]);
        if (k && pos[k] === undefined) pos[k] = i;
      }
      var perdidas = 0;
      lista.forEach(function (o) {
        var i = pos[o.chave];
        if (i === undefined) { perdidas++; return; }
        for (var nome in o.valores) planilha.definir(i, nome, o.valores[nome]);
      });
      recarregarSuave();
      if (perdidas) toast(perdidas + " edição(ões) eram de linhas que saíram da lista na carga nova.", true);
    }, function () { recarregando = false; });
  }


  function esperarGravacao(){
    if (!gravando) return Promise.resolve();
    return new Promise(function (ok) {
      var t = setInterval(function () { if (!gravando) { clearInterval(t); ok(); } }, 150);
    });
  }

  function agendarGravacao(){
    clearTimeout(tGravar);
    $("tagEstado").textContent = "editando…";
    tGravar = setTimeout(gravar, (doc.linhas || []).length > 50000 ? 4000 : 1200);
  }
  function carimbo(){
    var d = new Date(doc.atualizadoEm || agora());
    var p = function(n){ return (n<10?"0":"") + n; };
    $("carimbo").textContent = "atualizada em " + p(d.getDate()) + "/" + p(d.getMonth()+1) + "/"
      + d.getFullYear() + " às " + p(d.getHours()) + ":" + p(d.getMinutes());
  }

  /* =======================================================================
     o objeto planilha — é o que a parte 2 (o visual) enxerga
     ======================================================================= */
  var planilha = {
    slug: SLUG, titulo: "", admin: true,
    colunas: [], linhas: [], filtradas: [], filtros: filtros,

    // chama no início (se os dados já chegaram) e a cada mudança
    aoMudar: function (fn) {
