      (doc.colunas || []).forEach(function (c) { nomeVelho[c.id] = c.nome; });
      novas.forEach(function (c) { vivos[c.id] = true; });

      // colunas que saíram: apaga o valor delas em todas as linhas
      (doc.colunas || []).forEach(function (c) {
        if (!vivos[c.id]) doc.linhas.forEach(function (l) { delete l[c.nome]; if (l.__b !== undefined) delete l.__b; if (l.__k !== undefined) delete l.__k; });
      });
      // colunas renomeadas: troca a chave
      novas.forEach(function (c) {
