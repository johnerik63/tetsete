<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Listas · Coord PE</title>
<style>
  :root{
    --azul:#00306E; --azul2:#004A9F; --azul3:#0A63C9;
    --laranja:#EC7000; --laranja2:#FF8A1E;
    --areia:#F3F5F9; --linha:#DCE2EC; --linha2:#EDF1F6;
    --texto:#16202E; --fraco:#68758A;
    --ok:#12784A; --alerta:#B25E00; --ruim:#B3261E;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--areia);color:var(--texto);
       font:14px/1.45 Inter,"Segoe UI",system-ui,-apple-system,sans-serif;
       font-variant-numeric:tabular-nums}
  .app{display:flex;flex-direction:column;height:100vh;overflow:hidden}
  /* ---------- topo ---------- */
  .top{background:var(--azul);color:#fff;padding:14px 20px 12px;
       border-bottom:3px solid var(--laranja);display:flex;
       justify-content:space-between;align-items:center;gap:18px;flex-wrap:wrap}
  .marca{display:flex;align-items:center;gap:13px;min-width:0}
  .marca .selo{width:34px;height:34px;border-radius:8px;background:var(--laranja);flex:none;
       overflow:hidden;display:block}
  .marca .selo.comLogo{background:none}
  .marca .selo img,.marca .selo svg{width:100%;height:100%;object-fit:contain;display:block}
  .marca h1{margin:0;font-size:18px;font-weight:650;letter-spacing:-.2px;
       white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .marca p{margin:1px 0 0;font-size:12px;color:#A9C2E4}
  .top .dir{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
  .top .tag{background:#ffffff22;border:1px solid #ffffff33;
       color:#fff;border-radius:99px;padding:3px 11px;font-size:12px;font-weight:600}
  /* ---------- botoes ---------- */
  button{font:inherit;font-size:12.5px;font-weight:600;cursor:pointer;border-radius:8px;
         border:1px solid var(--linha);background:#fff;color:var(--azul);padding:7px 13px}
  button:hover{border-color:#B9C6D9;background:#fbfcfe}
  button.pri{background:var(--laranja);border-color:var(--laranja);color:#fff}
  button.pri:hover{background:var(--laranja2);border-color:var(--laranja2)}
  button.claro{background:#ffffff1a;border-color:#ffffff40;color:#fff}
  button.claro:hover{background:#ffffff2e}
  button.lig{background:#FFF3E6;border-color:#F6C793;color:#8A4B00}
  button.mini{padding:2px 8px;font-size:11px;border-radius:6px}
  button:disabled{opacity:.65;cursor:progress}
  button.claro:disabled:hover{background:#ffffff1a;border-color:#ffffff40}
  button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--laranja);outline-offset:1px}
  /* ---------- barra de ferramentas ---------- */
  .ferr{display:flex;align-items:center;gap:8px;padding:9px 14px;background:#fff;
        border-bottom:1px solid var(--linha);flex-wrap:wrap}
  .busca{position:relative;flex:1 1 260px;max-width:380px}
  .busca input{width:100%;padding:8px 11px 8px 30px;border:1px solid var(--linha);
        border-radius:8px;font:inherit;font-size:13px;background:var(--areia)}
  .busca input:focus{background:#fff;border-color:var(--azul3)}
  .busca .lupa{position:absolute;left:10px;top:50%;transform:translateY(-50%);
        color:var(--fraco);font-size:13px;pointer-events:none}
  .menu{position:relative}
  .menu .lista{position:absolute;z-index:40;top:calc(100% + 5px);right:0;min-width:230px;
        max-height:340px;overflow:auto;background:#fff;border:1px solid var(--linha);
        border-radius:10px;box-shadow:0 12px 30px #00306e26;padding:6px;display:none}
  .menu.aberto .lista{display:block}
  .menu .lista label{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:6px;
        font-size:13px;cursor:pointer;white-space:nowrap}
  .menu .lista label:hover{background:var(--areia)}
  .menu .lista .cab{font-size:11px;color:var(--fraco);padding:5px 8px;border-bottom:1px solid var(--linha2);
        margin-bottom:4px;display:flex;justify-content:space-between;gap:10px}
  .menu .lista .cab button{padding:2px 8px;font-size:11px}
  /* ---------- grade ---------- */
  .env{flex:1;overflow:auto;background:#fff;position:relative}
  table{border-collapse:separate;border-spacing:0;font-size:13px;
        width:max-content;min-width:100%;table-layout:fixed}
  th,td{border-right:1px solid var(--linha2);border-bottom:1px solid var(--linha2);
        padding:0;white-space:nowrap;background:#fff}
  thead th{position:sticky;top:0;z-index:6;background:var(--azul);color:#fff;
        border-right:1px solid #ffffff26;border-bottom:0;text-align:center;
        padding:8px 9px;font-size:11.5px;font-weight:600;cursor:pointer;user-select:none}
  thead th:hover{background:var(--azul2)}
  thead th .seta{color:var(--laranja2);font-size:10px;margin-left:4px}
  /* ---------- painel de filtros ---------- */
  .filtros{display:none;grid-template-columns:repeat(auto-fill,minmax(196px,1fr));gap:10px 12px;
        padding:11px 14px 12px;background:#EAF0F8;border-bottom:1px solid var(--linha);
        max-height:34vh;overflow:auto}
  .filtros.on{display:grid}
  .filtros .campoF{min-width:0}
  .filtros .campoF > .rot{font-size:11px;font-weight:650;color:var(--azul);margin-bottom:4px;
        white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:center}
  .filtros input,.filtros select{width:100%;min-width:0;border:1px solid #C6D2E2;
        border-radius:6px;padding:5px 7px;font:inherit;font-size:12px;background:#fff;color:var(--texto)}
  .filtros .par{display:flex;gap:4px}
  .filtros input[type=date],td input[type=date]{cursor:pointer}
  .filtros .ativo{border-color:var(--laranja);background:#FFF7EE}
  th .puxa{position:absolute;top:0;right:-4px;width:9px;height:100%;cursor:col-resize;z-index:7}
  th .puxa:hover{background:linear-gradient(90deg,transparent 3px,var(--laranja2) 3px,
        var(--laranja2) 6px,transparent 6px)}
  th{position:relative}
  #tab.apertado thead th{padding:7px 6px;font-size:11px}
  #tab.apertado td .cel,#tab.apertado td .barra{padding:0 6px;font-size:12px}
  #tab.apertado td input,#tab.apertado td select{padding:0 6px;font-size:12px}
  #tab.apertado .chip{padding:1px 6px;font-size:11px}
  td{height:31px}
  td .cel{display:block;padding:0 9px;line-height:30px;overflow:hidden;
        text-overflow:ellipsis;text-align:center}
  td.num .cel,td.num input{text-align:center}
  td input,td select{width:100%;height:30px;border:0;background:transparent;padding:0 9px;
        font:inherit;font-size:13px;color:inherit;text-align:center}
  td input:focus,td select:focus{outline:0;background:#FFF7EE;box-shadow:inset 0 0 0 2px var(--laranja)}
  td.edit{background:#FFFDF8}
  tbody tr:nth-child(even) td{background:#FAFBFD}
  tbody tr:nth-child(even) td.edit{background:#FFFCF5}
  tbody tr:hover td{background:#EEF4FD}
  tbody tr.sel td{background:#DDE9FB}
  tbody tr.fora td{background:#FFF6F5}
  tbody tr.fora:hover td{background:#FDECEA}
  td.fixa,th.fixa{position:sticky;z-index:4}
  thead th.fixa{z-index:8}
  .borda-fixa{border-right:2px solid #C3D0E2!important}
  .chip{display:inline-block;padding:1px 9px;border-radius:99px;font-size:11.5px;font-weight:600;
        line-height:19px;background:var(--linha2);color:#3A4759}
  .chip.a{background:#E7F1FF;color:#0A4FA8}
  .chip.b{background:#FFF0DF;color:#8A4B00}
  .chip.c{background:#E4F5EC;color:#12784A}
  .chip.d{background:#FDE7E5;color:#9C2A22}
  .barra{position:relative;display:block;padding:0 9px;line-height:30px;text-align:center}
  .barra i{position:absolute;left:4px;top:6px;bottom:6px;background:#FFE2C2;border-radius:3px;z-index:0}
  .barra span{position:relative;z-index:1;font-weight:600}
  .venc{color:var(--ruim);font-weight:600}
  .obs{cursor:pointer;color:var(--azul3);text-decoration:underline dotted}
  .vazio{padding:40px 20px;text-align:center;color:var(--fraco)}
  .mais{padding:11px;text-align:center;color:var(--fraco);font-size:12.5px}
  /* ---------- rodape ---------- */
  .status{display:flex;align-items:center;gap:14px;padding:7px 16px;background:var(--azul);
          color:#D6E3F5;font-size:12.5px;flex-wrap:wrap;border-top:3px solid var(--laranja)}
  .status b{color:#fff;font-weight:650}
  .status .dirF{margin-left:auto;display:flex;gap:14px;flex-wrap:wrap}
  .status .pag{display:flex;align-items:center;gap:7px;padding-left:6px;
        border-left:1px solid #ffffff33}
  .status .pag button{padding:2px 9px;font-size:12px;line-height:1.35}
  .status .pag button:disabled{opacity:.35;cursor:default}
  .status .pag #pgTxt{color:#fff;font-weight:650;white-space:nowrap}
  /* ---------- ficha lateral ---------- */
  .lat{position:fixed;top:0;right:0;bottom:0;width:min(430px,92vw);background:#fff;z-index:80;
       box-shadow:-14px 0 40px #00306e2e;transform:translateX(102%);transition:transform .18s ease;
       display:flex;flex-direction:column}
  .lat.on{transform:none}
  .lat header{background:var(--azul);color:#fff;padding:14px 16px;display:flex;
       justify-content:space-between;align-items:flex-start;gap:12px}
  .lat header h2{margin:0;font-size:15px}
  .lat header p{margin:2px 0 0;font-size:12px;color:#A9C2E4}
  .lat .conteudo{overflow:auto;padding:6px 16px 20px}
  .lat .par{display:grid;grid-template-columns:44% 1fr;gap:10px;padding:8px 0;
       border-bottom:1px solid var(--linha2);font-size:13px}
  .lat .par .r{color:var(--fraco)}
  .lat .par .v{font-weight:600;word-break:break-word;white-space:pre-wrap}
  .fundo{position:fixed;inset:0;background:#0a1a2e4d;z-index:70;display:none}
  .fundo.on{display:block}

  /* ---------- avisos, janelas e tela de carga ---------- */
  #aviso:empty{display:none}
  #aviso{padding:9px 14px;background:#FFF7EE;border-bottom:1px solid #F6C793;
         color:#8A4B00;font-size:12.5px;display:flex;gap:10px;align-items:center}
  /* ---------- tela de carregamento ---------- */
  .capa{position:fixed;inset:0;z-index:95;display:flex;align-items:center;justify-content:center;
        background:rgba(243,245,249,.74);-webkit-backdrop-filter:blur(2px);backdrop-filter:blur(2px)}
  .capa.cheia{background:var(--areia);-webkit-backdrop-filter:none;backdrop-filter:none}
  .capa.off{display:none}
  /* operação rápida não pisca: só aparece se passar de 1/4 de segundo */
  .capa.atrasada{will-change:opacity;animation:capaAparece .15s linear .25s both}
  @keyframes capaAparece{from{opacity:0}to{opacity:1}}
  .capaCaixa{background:#fff;border:1px solid var(--linha);border-radius:14px;
        box-shadow:0 18px 50px #00306e26;padding:22px 26px 20px;width:min(360px,88vw);
        display:flex;flex-direction:column;align-items:center;gap:7px;text-align:center}
  .capa.cheia .capaCaixa{box-shadow:0 6px 24px #00306e14}
  .giro{width:38px;height:38px;border-radius:50%;border:4px solid #FFE2C2;border-top-color:var(--laranja);
        animation:gira .8s linear infinite;will-change:transform;margin-bottom:5px}
  @keyframes gira{to{transform:rotate(360deg)}}
  .capaTit{font-size:15px;font-weight:650;color:var(--azul)}
  .capaSub{font-size:12.5px;color:var(--fraco);min-height:1.2em}
  .capaBarra{display:none;width:100%;height:6px;border-radius:99px;background:var(--linha2);
        overflow:hidden;margin-top:6px}
  .capaBarra i{display:block;height:100%;width:0;background:var(--laranja);border-radius:99px;
        transition:width .2s ease}
  .capaNum{display:none;font-size:11.5px;color:var(--fraco);font-weight:600}
  .capa.comPc .capaBarra,.capa.comPc .capaNum{display:block}
  .capa.falhou .giro{display:none}
  .capa.falhou .capaTit{color:var(--ruim)}
  #capaErro:empty{display:none}
  #capaErro{margin-top:8px}
  @media (prefers-reduced-motion:reduce){ .giro{animation-duration:2.4s} .capa.atrasada{animation-duration:0s} }
  .jan{position:fixed;z-index:92;top:50%;left:50%;transform:translate(-50%,-50%);
       width:min(700px,94vw);max-height:92vh;overflow:auto;background:#fff;border-radius:14px;
       box-shadow:0 24px 60px #00306e40;display:none}
  .jan.on{display:block}
  .jan header{background:var(--azul);color:#fff;padding:13px 16px}
  .jan header h2{margin:0;font-size:15px}
  .jan header p{margin:2px 0 0;font-size:12px;color:#A9C2E4}
  .jan .miolo{padding:15px 16px;font-size:13.5px;line-height:1.5}
  .jan .miolo label{display:block;font-size:11.5px;font-weight:650;color:var(--azul);margin:0 0 4px}
  .jan textarea{width:100%;height:210px;border:1px solid #C6D2E2;border-radius:8px;padding:9px 10px;
       font:12px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace;resize:vertical;background:#FAFBFD}
  .jan textarea:focus{background:#fff;border-color:var(--azul3)}
  .jan .pe{display:flex;gap:8px;justify-content:flex-end;padding:0 16px 15px;flex-wrap:wrap}
  .jan .pe .vaga{flex:1}
  .jan .nota{background:var(--areia);border:1px solid var(--linha);border-radius:8px;
       padding:10px 12px;font-size:12.5px;margin-top:12px}
  .jan .nota b{color:var(--azul)}
  .jan .conta{font-size:11.5px;color:var(--fraco);margin-top:6px}
  /* ---------- modo administrador (atrás do quadrado laranja) ---------- */
  #selo{cursor:pointer}
  #selo:hover{outline:2px solid #ffffff66;outline-offset:2px}
  .adm{position:fixed;inset:0;z-index:88;background:#fff;display:none;flex-direction:column}
  .adm.on{display:flex}
  .adm > header{background:var(--azul);color:#fff;padding:14px 18px;display:flex;
       justify-content:space-between;align-items:flex-start;gap:12px;border-bottom:3px solid var(--laranja)}
  .adm > header h2{margin:0;font-size:16px}
  .adm > header p{margin:2px 0 0;font-size:12px;color:#A9C2E4}
  .admAcoes{display:flex;gap:8px;align-items:center;padding:11px 18px;
       border-bottom:1px solid var(--linha);flex-wrap:wrap}
  .admAcoes label{font-size:11.5px;font-weight:650;color:var(--azul);
       display:flex;align-items:center;gap:7px}
  .admAcoes label input{border:1px solid #C6D2E2;border-radius:8px;padding:6px 9px;
       font:inherit;font-size:13px;min-width:240px}
  .admAcoes .vaga{flex:1}
  .admCorpo{flex:1;overflow:auto;padding:0 18px 12px}
  .admDica{font-size:12.5px;color:var(--fraco);padding:10px 0 8px}
  .admTab{width:100%;border-collapse:collapse;font-size:13px}
  .admTab th{position:sticky;top:0;background:var(--azul);color:#fff;font-size:10.5px;
       text-transform:uppercase;letter-spacing:.4px;padding:8px 9px;text-align:left;z-index:2;
       white-space:nowrap}
  .admTab td{border-bottom:1px solid var(--linha2);padding:5px 9px;background:#fff;white-space:nowrap}
  .admTab tr:nth-child(even) td{background:#FAFBFD}
  .admTab tr.apagada td{background:#FDF3F2;opacity:.55}
  .admTab input[type=text]{width:100%;min-width:150px;border:1px solid var(--linha);
       border-radius:6px;padding:5px 7px;font:inherit;font-size:12.5px}
  .admTab select{border:1px solid var(--linha);border-radius:6px;padding:5px 6px;
       font:inherit;font-size:12.5px;background:#fff;color:var(--texto)}
  .admTab select:disabled{opacity:.45}
  .admTab .pos{color:var(--fraco);font-size:11.5px;min-width:26px;display:inline-block}
  .admTab .mover{display:inline-flex;gap:3px;margin-left:4px}
  .admPe{display:flex;gap:8px;align-items:center;padding:11px 18px;border-top:1px solid var(--linha);
       background:var(--areia);flex-wrap:wrap}
  .admPe .vaga{flex:1}
  .admPe .info{font-size:12.5px;color:var(--fraco)}
  /* ---------- trazer arquivo do computador ---------- */
  .arq{border:1px dashed #C6D2E2;border-radius:10px;padding:12px 14px;background:#FAFBFD;
       display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}
  .arq.sobre{border-color:var(--laranja);background:#FFF7EE}
  .arq .info{font-size:12.5px;color:var(--fraco);flex:1;min-width:140px}
  .arq .info b{color:var(--texto)}
  .arq.pronto{border-style:solid;border-color:#B7E3C6;background:#F1FAF4}
  .ou{display:flex;align-items:center;gap:10px;color:var(--fraco);font-size:11.5px;
      text-transform:uppercase;letter-spacing:.5px;margin:2px 0 8px}
  .ou:before,.ou:after{content:"";flex:1;height:1px;background:var(--linha)}

  /* ---------- escolher as opções da lista suspensa ---------- */
  .opcTopo{display:flex;gap:8px;align-items:center;margin-bottom:8px;flex-wrap:wrap}
  .opcTopo input[type=text]{flex:1 1 160px;min-width:0;border:1px solid #C6D2E2;border-radius:8px;
       padding:7px 9px;font:inherit;font-size:13px;margin:0}
  .opcLista{max-height:280px;overflow:auto;border:1px solid var(--linha);border-radius:8px;padding:5px}
  .opcLista label{display:flex;align-items:center;gap:9px;padding:5px 8px;border-radius:6px;
       font-size:13px;cursor:pointer}
  .opcLista label:hover{background:var(--areia)}
  .jan .miolo input[type=checkbox]{width:auto;min-width:0;margin:0;flex:none;
       accent-color:var(--azul3)}
  .opcLista label span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .opcLista label small{margin-left:auto;color:var(--fraco);font-size:11.5px;white-space:nowrap}
  .opcLista .nada{padding:14px;text-align:center;color:var(--fraco);font-size:12.5px}
  .opcPe{font-size:12px;color:var(--fraco);margin-top:8px}
  .toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);z-index:99;
      background:var(--azul);color:#fff;padding:10px 16px;border-radius:99px;font-size:13px;
      font-weight:600;box-shadow:0 10px 30px #00306e4d;display:none}
  .toast.on{display:block}
  .toast.ruim{background:#8F1D13}
  @media (max-width:760px){ .marca h1{font-size:16px} }

