      var v = ($("opcNova").value || "").trim();
      if (!v) return;
      if (todos.indexOf(v) < 0) todos.push(v);
      marcada[v] = true;
      $("opcNova").value = "";
      pintar($("opcBusca").value);
    }
    $("opcAdd").onclick = acrescentar;
