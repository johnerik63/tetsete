        "ajustando as colunas em " + (doc.linhas || []).length.toLocaleString("pt-BR") + " linha(s)…");
      return tela.depoisDoQuadro().then(function () {
        return estruturaAgora(novas, titulo, chave);
      }).then(function () { tela.esconder(); }, function (e) { tela.esconder(); throw e; });
    },
    _estrutura: function (novas, titulo, chave) {
